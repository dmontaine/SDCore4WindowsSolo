* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 12 Nov 26 Windows port - SOLO 56 group 5: Linux Solo 608b511 (the layout service, the menu bar, $tk_std, the AI line), with the Windows difference the 25 Oct
*               carry made: no AI row (this tree has no AI helper, RELEASE_1.1 197), so three gates, no set.ai, no K$AI.STATUS read, and "Windows user".
*               The AI line itself is the toolkit's and is inert here, as on SD Core for Windows' pages.
* 24 Oct 26 dm  Solo carry 20: Solo's own.  SD Core has two pages under this name (the administrator's matrix of every registered account against every gate, and the account holder's read-only
*               "what my account may do and why") and changes a gate with modify.account.  Solo has ONE account, whose administrator is the person at the keyboard (ADMIN typed after sign-on),
*               and no modify.account: its gates are set by set.os.access (sh, os), set.net.access (net) and set.ai gate (ai).  So this is one page with four rows and two modes, and it has no
*               accounts, no filter, no queue and no route gates (Solo has no ssh, api or files routes of its own).  A DEVIATION FROM THE LINUX CORE TEMPLATE FOR AN OPERATING-SYSTEM-INDEPENDENT
*               REASON (one account, no modify.account), listed for the parity audit; the wording of the rows, the confirm box and the rule "typed name when a gate reaching beyond SD is turned ON" are Core's.
* 10 Nov 26 dm  SOLO CARRY (S.117): Core's shared frame, as every Core page has it: Esc and the menu bar, Ctrl-T, Ctrl-K, Ctrl-O and View > Mouse
*               ($tk_std), F6 / Shift-F6 between the boxes and the AI line ($tk_aipage, offered only refresh).  The page's own content is Solo's, unchanged.
* 12 Nov 26 dm  S.221 (Core-Solo parity audit, finding 7; owner, 12 Nov 2026: "Carry it"), SD Core's S.88 L2: the three boxes are panes of the layout service ($tk_layout).  At
*               140 by 43 they are exactly the boxes the page has always drawn; in a larger window every box takes the extra columns and the box about the cursor's row the extra
*               rows, and a resize is followed (refresh, the rectangles again, the page drawn again).  Every position on the page is now relative to its pane.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.GATES      (every session; the administrator's keys are offered only after ADMIN)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least), with three boxes:
*
*     Gates of this account   one row for each gate - sh, os, net - with whether it is ON or off FOR THIS SESSION (what LOGIN loaded), what the
*                             register says (the administrator only: what the next sign-on will load), how it is delivered (off), whether it reaches beyond SD and when a change reaches you
*     The row under the cursor  what the gate is, in plain sentences: what ON lets the account do, what it can still do with it off, and the command that changes it
*     Where this comes from   where each state is read
*
*   Keys: Up, Down, PgUp, PgDn, Home, End move; Enter or the space bar (the administrator only) turns the gate on the cursor's row ON or off through the real verb; F5 reads again; F1 or ? or a click on
*   the [?] explains the page; Ctrl-Q leaves.  There is NO key that turns everything ON, and no gate is on as delivered.
*
*   THE PAGE CHANGES NOTHING ITSELF AND PROBES NOTHING.  What it shows it asks the kernel (kernel(K$SH, -1), K$OS.EXEC, K$NET), and the register (accounts/sduser, the administrator only);
*   it never tries an operation to learn whether it works.  Enter builds ONE sentence from a table that is in this program (set.os.access sh on, set.os.access os off, set.net.access on
*   ...), shows it with its effect in a box answered Run or Cancel (Cancel is what Enter chooses) and runs it through $tk_run, which allows only these three commands.  Turning ON a gate asks
*   for the gate's name to be typed, because every gate here reaches beyond SD.  Each verb asks for the administrator itself and writes its own audit line.  After the command it reads again and shows the
*   verb's own words; a cell is never changed on the page's say-so.  A change does not reach a session that is already running (the gates are loaded at sign-on).
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_gates
$catalog $tool_gates

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'set.os.access set.net.access'                       ;* the commands this page may run
   acc.name = 'sduser'                                          ;* Solo's one account (ruling 29); the register record the three verbs write

   call $tk_open('tool.gates', '', ctx, err)
   if err # '' then
      display err
      stop
   end
   gosub declare.layout
   adm = (if kernel(K$ADMINISTRATOR, -1) then 1 else 0)
   if adm then void kernel(K$AUDIT, 'tool start app=tool.gates')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   if adm then call $tk_keys('add', keys, 'enter', 'change', 'change', '', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* Esc opens the menu bar, as on every page
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   if adm then call $tk_keys('menu', keys, 'change', '&Gate', '&Turn the gate on or off', '', '')      ;* the administrator's, as Enter is
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* Ctrl-T theme, Ctrl-K keys and their View and Help entries, as on every page
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')  ;* the AI line is offered only refresh: no change of a setting is proposed by it
   call $tk_aipage('init', ctx, keys, '', '', aout)
   if aout then gosub declare.layout                     ;* the AI line took the body's last row: the panes again (as SD Core's pages)

*  The table: one row to a gate, in the order the page shows them.  The words are the verbs' own (set.os.access, set.net.access).  Linux Solo's AI row is not here: this tree has no AI helper.
   gids = 'sh' : @fm : 'os' : @fm : 'net'
   gti = 'Shell' : @fm : 'OS.EXECUTE' : @fm : 'Remote files'
   gcmd.on = 'set.os.access sh on' : @fm : 'set.os.access os on' : @fm : 'set.net.access on'
   gcmd.off = 'set.os.access sh off' : @fm : 'set.os.access os off' : @fm : 'set.net.access off'
   gwhen = 'next sign-on' : @fm : 'next sign-on' : @fm : 'next sign-on'
   gall = "use the SH verb and ! to run operating-system commands as your Windows user"
   gall<2> = "run OS.EXECUTE, the embedded Python, a print unit's SPOOLER string and the editors that run outside SD, and reach files and directories outside the account by pathname"
   gall<3> = 'open a file on another SD server through a server definition, and have its own files opened over the API by request 29'
   gstill = "do everything inside SD, with the account's own files"
   gstill<2> = 'open and write files inside its own account directory'
   gstill<3> = 'open every file on this computer that its other gates allow'
   NG = 3

   VIS = 3                                                      ;* gate rows on the screen
   ci = 1                                                       ;* the gate under the cursor
   gen = 0
   msg = (if adm then "Up and Down move; Enter turns the gate on the cursor's row ON or off" else 'Up and Down move; this page only shows what you may do, it cannot alter it')
   done = 0

   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, 'Gates', '', '', mr)            ;* the bar first: it writes row 0 whole
      call $tk_frame(ctx, keys, 'Gates', msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, 'Gates', nm, ao)           ;* while the AI line has the focus it takes the keys
      if ao<1> = 'replay' then nm = ao<2>                                            ;* an action the AI proposed and the person accepted
      if ao<1> # '' then msg = ao<4>
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, 'Gates', nm, 0, mr)       ;* F10, Alt and a letter, and Esc: the bar
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1                                                               ;* the preview, the wait and the answer covered the page
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', lchg)
            gosub get.rects
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the machine says

* The state of every gate: gnow = what THIS SESSION holds (1 on, 0 off, null when it cannot be read), gset = what the register says (the administrator only).  The administrator may have changed since this session signed on, so the two may differ until the next sign-on.
read.all:
   adm = (if kernel(K$ADMINISTRATOR, -1) then 1 else 0)
   gnow = '' ; gset = ''
   gnow<1> = (if kernel(K$SH, -1) then 1 else 0)
   gnow<2> = (if kernel(K$OS.EXEC, -1) then 1 else 0)
   gnow<3> = (if kernel(K$NET, -1) then 1 else 0)
   reg.ok = 0
   if adm then
      openpath @sdsys:@ds:'accounts' to acc.f then
         read acc.rec from acc.f, acc.name then
            reg.ok = 1
            gset<1> = (if upcase(trim(acc.rec<ACC$SH>)) = 'YES' then 1 else 0)
            gset<2> = (if upcase(trim(acc.rec<ACC$OS.EXEC>)) = 'YES' then 1 else 0)
            gset<3> = (if upcase(trim(acc.rec<ACC$NET>)) = 'YES' then 1 else 0)
         end
         close acc.f
      end
   end
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.221, SD Core's S.88 L2).  The three boxes are panes of the layout service, declared in the sizes of the reference layout (140 by 43, the
* body 138 by 39): the gates and the source keep their height and take the extra columns, the box about the cursor's row takes the extra rows as well.
* Out: gat (the gates), row (the row under the cursor), src (where this comes from), each .x .y .w .h.
declare.layout:
   ld = ''
   ld<1> = 'gates' : @vm : 1 : @vm : 1 : @vm : 11 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   ld<2> = 'row' : @vm : 2 : @vm : 1 : @vm : 14 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   ld<3> = 'source' : @vm : 3 : @vm : 1 : @vm : 9 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   call $tk_layout('declare', ctx, ld, perr)
   if perr # '' then
      call $tk_close(ctx)
      display perr
      stop
   end
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'gates', lrc)
   gat.x = lrc<1, 1> ; gat.y = lrc<1, 2> ; gat.w = lrc<1, 3> ; gat.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'row', lrc)
   row.x = lrc<1, 1> ; row.y = lrc<1, 2> ; row.w = lrc<1, 3> ; row.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'source', lrc)
   src.x = lrc<1, 1> ; src.y = lrc<1, 2> ; src.w = lrc<1, 3> ; src.h = lrc<1, 4>
   return

draw.all:
   cw2 = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,1 size cw2,chh
   screen box at gat.x,gat.y size gat.w,gat.h title 'Gates of this account'
   screen box at row.x,row.y size row.w,row.h title 'The row under the cursor'
   screen box at src.x,src.y size src.w,src.h title 'Where this comes from'
   gosub draw.list
   gosub draw.row
   gosub draw.source
   return

* The text of a state: ON, off, or - when it cannot be read
state.text:
   begin case
      case st.v = ''
         st.t = '-'
      case st.v = 1
         st.t = 'ON'
      case 1
         st.t = 'off'
   end case
   return

draw.list:
   tw = gat.w - 4                                                ;* the text width of the box (134 at 140 by 43)
   tx = gat.x + 2
   screen text fmt('Gate', '16L') : fmt('This session', '14L') : fmt('Register', '10L') : fmt('As delivered', '14L') : fmt('Beyond SD', '11L') : 'A change reaches you' at tx,gat.y + 1 attr 'header' width tw
   for r = 1 to VIS
      k = r
      st.v = gnow<k>
      gosub state.text
      now.t = st.t
      st.v = gset<k>
      gosub state.text
      set.t = st.t
      screen text fmt(gti<k>, '16L') : fmt(now.t, '14L') : fmt(set.t, '10L') : fmt('off', '14L') : fmt('yes', '11L') : gwhen<k> at tx,gat.y + 1 + r attr (if k = ci then 'highlight' else 'normal') width tw
   next r
   n.on = 0
   for k = 1 to NG
      if gnow<k> = 1 then n.on += 1
   next k
   s = 'Signed on as ' : @logname : ' in the account ' : @who : '.  ' : n.on : ' of ' : NG : ' gates are on for this session.'
   screen text fmt(s, tw : 'L') at tx,gat.y + 7 attr 'bold' width tw
   if adm then
      s = "You are the administrator: Enter turns the gate on the cursor's row ON or off through its verb, after a box you answer Run or Cancel."
   end else
      s = 'Only the administrator can change a gate (type admin).  Nothing on this page can.'
   end
   screen text fmt(s, tw : 'L') at tx,gat.y + 8 width tw
   screen text fmt((if adm then 'The Register column is what the next sign-on will load.' else 'The Register column is shown to the administrator only.'), tw : 'L') at tx,gat.y + 9 width tw
   call $tk_help('mark', gat.x + gat.w - 5, gat.y + 1, 0, 0)
   return

* In plain sentences, for the gate under the cursor
draw.row:
   lines = ''
   k = ci
   if k >= 1 and k <= NG then
      begin case
         case 1
            if gnow<k> = 1 then
               lines<-1> = gti<k> : ' [' : gids<k> : ']  -  ON for this session.  You can ' : gall<k> : '.'
               lines<-1> = 'With it off you could still ' : gstill<k> : '.'
            end else
               lines<-1> = gti<k> : ' [' : gids<k> : ']  -  off for this session.  You cannot ' : gall<k> : '.'
               lines<-1> = 'With it off you can still ' : gstill<k> : '.'
            end
            if adm then
               if gset<k> # '' and gset<k> # gnow<k> then
                  lines<-1> = 'The register says ' : (if gset<k> = 1 then 'ON' else 'off') : ' and this session holds ' : (if gnow<k> = 1 then 'ON' else 'off') : ': ' : gti<k> : ' reaches you ' : gwhen<k> : '.'
               end
               lines<-1> = 'Enter runs: ' : (if gset<k> = 1 then gcmd.off<k> else gcmd.on<k>)
            end else
               lines<-1> = 'The administrator changes it with: ' : (if gnow<k> = 1 then gcmd.off<k> else gcmd.on<k>)
            end
            lines<-1> = 'As delivered it is off.  A change reaches you: ' : gwhen<k> : '.  It does not touch a session that is already running.  This gate reaches BEYOND SD.'
      end case
   end
   ww = row.w - 4
   gosub wrap.lines
   for r = 1 to row.h - 2
      screen text fmt(lines<r>, ww : 'L') at row.x + 2,row.y + r width ww
   next r
   return

draw.source:
   lines = ''
   lines<-1> = "Every gate is off as delivered and only the administrator turns one on.  What this page says is what this session holds right now, asked of the system - nothing is tried to find out."
   lines<-1> = "sh, os and net were loaded when you signed on (the administrator passes the first two on its own), so a change by the administrator shows in the This session column after the next sign-on."
   lines<-1> = "The Register column is the record of this account in the system's register (fields sh, os.exec and net), read for the administrator only."
   ww = src.w - 4
   gosub wrap.lines
   for r = 1 to src.h - 2
      screen text fmt(lines<r>, ww : 'L') at src.x + 2,src.y + r width ww
   next r
   return

* A SCREEN TEXT longer than its width is cut, not wrapped.  In: lines, ww (the width of the box's text)
wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      if lines<wi> = '' then
         wrapped<-1> = ''
      end else
         call $tk_wrap(lines<wi>, ww, pieces)
         wrapped<-1> = pieces
      end
   next wi
   lines = wrapped
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   begin case
      case nm = 'up'
         if ci > 1 then
            ci -= 1
            gosub redraw
         end
      case nm = 'down'
         if ci < NG then
            ci += 1
            gosub redraw
         end
      case nm = 'pgup' or nm = 'home'
         ci = 1
         gosub redraw
      case nm = 'pgdn' or nm = 'end'
         ci = NG
         gosub redraw
      case nm = 'enter' or nm = ' '
         gosub change
      case nm = 'f1' or nm = '?'
         call $tk_help('box', 'tool.gates.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'asked the system again'
      case nm = 'ctrl-t'                    ;* the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-o'                    ;* the log of the commands this page ran (View > Output; $tk_std)
         call $tk_std('output', ctx, keys, '', std.r)
      case nm = 'ctrl-k'                    ;* the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, 'Gates', std.r)
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, 1, nm : @fm : 1, ap)            ;* F6 / Shift-F6 go round the box and the AI line; AI > Ask the AI goes to the line
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
   end case
   return

redraw:
   gosub draw.list
   gosub draw.row
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, 'Gates', mev, '', mr)                   ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key
      return
   end
   call $tk_aipage('mouse', ctx, keys, 'Gates', mev, ap)                          ;* a click on the AI line gives it the focus
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, gat.x + gat.w - 5, gat.y + 1, hit.m)
   if hit.m then
      call $tk_help('box', 'tool.gates.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      if my >= gat.y + 2 and my <= gat.y + 1 + VIS and mx >= gat.x + 2 and mx <= gat.x + gat.w - 3 then
         ci = my - gat.y - 1
         gosub redraw
      end
   end
   return

* ------------------------------------------------------------------------------------------------- changing a gate: the command, its effect, Run or Cancel, then the machine's answer

* Enter on a gate: the opposite of the register's state, through the verb that owns it
change:
   if not(kernel(K$ADMINISTRATOR, -1)) then
      msg = 'Only the administrator can change a gate: type admin, then open this page again'
      return
   end
   k = ci
   if not(reg.ok) then
      msg = 'the register could not be read, so nothing is changed'
      return
   end
   on.now = (gset<k> = 1)
   sent = (if on.now then gcmd.off<k> else gcmd.on<k>)
   el = ''
   typed = ''
   if on.now then
      el<-1> = 'OFF - ' : gti<k> : ': this account will no longer be able to ' : gall<k> : '.'
      el<-1> = 'It will still be able to ' : gstill<k> : '.'
   end else
      el<-1> = 'ON  - ' : gti<k> : ': this account will be able to ' : gall<k> : '.'
      el<-1> = 'A gate that is off as delivered is being turned ON.  Leaving it off is the tighter choice; you decide.'
      el<-1> = 'This gate reaches beyond SD, so its name has to be typed.'
      typed = gids<k>
   end
   el<-1> = 'A running session is not changed.  A change reaches you: ' : gwhen<k> : '.'
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, st, err)
      if err # '' then
         msg = err
      end else
         said = ''                                               ;* the verb's last line: the state afterwards
         for oi = dcount(out, @fm) to 1 step -1
            if trim(out<oi>) # '' then
               said = trim(out<oi>)
               exit
            end
         next oi
         msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

end

* END-CODE
