* START-DESCRIPTION:
*
*    sd -internal RUN gpl.bp solo_password ADMIN     (password on the input)
*    sd -internal RUN gpl.bp solo_password GLOBAL    (managed mode (b) only)
*
* The installer's step for rulings 12 and 15: the administrator password is
* set at install, and the global password only in managed mode - its presence
* IS mode (b), and nothing after install sets or clears it.  So this refuses
* unless the session is internal, which LOGIN admits only against the
* installer's one-shot marker (ruling 13).
*
* THE PASSWORD ARRIVES ON THE INPUT, never on the command line, where it would
* be in the process list and the audit record of the command.  The installer
* writes it to sd's standard input.
*
* Stored by !CRED_SET as a SCRAM verifier in $cred under $ADMIN or $GLOBAL,
* the same record format an API login is checked against (SOLO 6).  The
* password is not echoed, displayed or logged.
*
* The last line on success is "SOLO PASSWORD SET <ADMIN|GLOBAL>".
*
* END-DESCRIPTION
*
* START-CODE

$internal
program solo_password

$include keys.h
$include int$keys.h
$include err.h

   prompt ''
   @system.return.code = -ER$ARGS

   if not(kernel(K$INTERNAL, -1)) then
      display 'solo_password: only the installer may run this.'
      stop
   end

*  RUN gpl.bp solo_password <which> - the fourth word.
   which = upcase(trim(field(trim(@sentence), ' ', 4)))
   if which # 'ADMIN' and which # 'GLOBAL' then
      display 'solo_password: say ADMIN or GLOBAL.'
      stop
   end

   input pw HIDDEN
   if pw = '' then
      display 'solo_password: no password was given.'
      stop
   end

   ok = @false
   call !CRED_SET('$' : which, pw, ok)
   pw = ''

   if not(ok) then
      display 'solo_password: the password could not be stored (status ' : status() : ').'
      stop
   end

   void kernel(K$AUDIT, 'SOLO PASSWORD SET ' : which)
   @system.return.code = 0
   display 'SOLO PASSWORD SET ' : which
end

* END-CODE
