* START-HISTORY:
* 25 Sep 26 SD Core Solo - refuses a password with any character outside
*           printable ASCII (33-126): a UTF-8 BOM from the installer's writer
*           had been stored silently in front of every password.
* 25 Sep 26 SD Core Solo - API <name>: the user's own API password (ruling
*           18), stored under the account's name, the record apisrvr's SCRAM
*           reads.  The account must be in the register.
* 25 Sep 26 SD Core Solo - new, SOLO 5.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    sd -internal RUN gpl.bp solo_password ADMIN     (password on the input)
*    sd -internal RUN gpl.bp solo_password GLOBAL    (managed mode (b) only)
*    sd -internal RUN gpl.bp solo_password API <account>   (ruling 18)
*
* API is the password the user logs in to the API with (SCRAM, apisrvr).  It
* is stored under the ACCOUNT's name, upper-cased - the key apisrvr reads -
* and only for an account in the register, so it can never land on $ADMIN or
* $GLOBAL (an account name starts with a letter, solo_account).
*
* The installer's step for rulings 12 and 15: the administrator password is
* set at install, and the global password only in managed mode - its presence
* IS mode (b), and nothing after install sets or clears it.  So this refuses
* unless the session is internal, which LOGIN admits only against the
* installer's one-shot marker (ruling 13).
*
* THE PASSWORD ARRIVES ON THE INPUT, never on the command line, where it would
* be in the process list and the audit record of the command.  The installer
* writes it to sd's standard input.
*
* Stored by !CRED_SET as a SCRAM verifier in $cred under $ADMIN or $GLOBAL,
* the same record format an API login is checked against (SOLO 6).  The
* password is not echoed, displayed or logged.
*
* The last line on success is "SOLO PASSWORD SET <ADMIN|GLOBAL>".
*
* END-DESCRIPTION
*
* START-CODE

$internal
program solo_password

$include keys.h
$include int$keys.h
$include err.h

   prompt ''
   @system.return.code = -ER$ARGS

   if not(kernel(K$INTERNAL, -1)) then
      display 'solo_password: only the installer may run this.'
      stop
   end

*  RUN gpl.bp solo_password <which> - the fourth word.
   which = upcase(trim(field(trim(@sentence), ' ', 4)))
   if which # 'ADMIN' and which # 'GLOBAL' and which # 'API' then
      display 'solo_password: say ADMIN, GLOBAL or API <account>.'
      stop
   end

*  The credential record's key: '$ADMIN' / '$GLOBAL', or the account's name.
   cred.key = '$' : which
   if which = 'API' then
      acc.name = downcase(trim(field(trim(@sentence), ' ', 5)))
      if acc.name = '' or not(alpha(acc.name[1,1])) then
         display 'solo_password: API needs the account name.'
         stop
      end
      openpath @sdsys : @ds : 'accounts' to acc.f else
         display 'solo_password: cannot open the account register.'
         stop
      end
      read acc.rec from acc.f, acc.name else
         display 'solo_password: ' : acc.name : ' is not in the account register.'
         stop
      end
      close acc.f
      cred.key = upcase(acc.name)
   end

   input pw HIDDEN
   if pw = '' then
      display 'solo_password: no password was given.'
      stop
   end

*  25 Sep 26 - PRINTABLE ASCII ONLY, REFUSED OUT LOUD.  A caller's .NET text
*  writer once put a UTF-8 byte-order mark before the password, and this
*  stored EF BB BF + password without a word - so no typed password could
*  match it and SCRAM refused the right one as "wrong password".  The
*  installer allows 33-126 only; anything else here is a caller's defect,
*  and storing it silently is what made that one invisible.
   for i = 1 to len(pw)
      c = seq(pw[i,1])
      if c < 33 or c > 126 then
         pw = ''
         display 'solo_password: the password holds a character outside printable ASCII (code ' : c : ' at position ' : i : '); nothing was stored.'
         stop
      end
   next i

   ok = @false
   call !CRED_SET(cred.key, pw, ok)
   pw = ''

   if not(ok) then
      display 'solo_password: the password could not be stored (status ' : status() : ').'
      stop
   end

   void kernel(K$AUDIT, 'SOLO PASSWORD SET ' : which)
   @system.return.code = 0
   display 'SOLO PASSWORD SET ' : which
end

* END-CODE
