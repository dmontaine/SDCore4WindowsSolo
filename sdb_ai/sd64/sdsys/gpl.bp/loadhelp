* START-HISTORY:
* 26 Oct 26 Windows port - the file is made with CREATE.FILE ... DIRECTORY <system directory> from whatever directory the session is in (see the comment at OPENPATH).
* 23 Oct 26 dm  New (S.75; the owner: "Context help should be stored in the shared account as the file context.help, keyed using whatever id system you wish").
* 23 Oct 26 dm  SOLO CARRY 14 (Core 72e708e): Solo has no shared account, so the file is in the system directory (next to pdf and helptext); the installer's internal session has no LOGTO.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   LOAD.HELP
*
*   The administrator's verb, run by the stage script at install and upgrade and by hand after the text under helptext changes.  Every file of the
*   helptext directory of the SD system directory (the install directory, e.g. ~/SDCoreSolo/helptext) is one record of the file context.help in the same directory: the FILE NAME is
*   the record id (a-z 0-9 dot dash underscore, up to 80 characters), line 1 is the title, line 2 the name of a documentation PDF (blank for none), and each
*   later line is one paragraph.  The file is made (dynamic) when it is not there, from a session whose directory is the system directory (the installer's internal
*   session); from the account the file is only filled, so it must already exist.  A record that is already the same is not written;
*   a record the administrator added under an id that is not shipped is kept.  The shipped records are replaced, so a change to a shipped record is made in
*   helptext, not in the file.
*
*   A file that cannot be read, or that has no title or a name that is not a key, is skipped and named.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program load.help
$catalog $loadhelp

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001) ;* Command requires administrator privileges
   end

   keychars = 'abcdefghijklmnopqrstuvwxyz0123456789._-'

   src = @sdsys : @ds : 'helptext'
   entries = dir(src)
   if entries = '' then stop sysmsg(12840, src)                  ;* The help text directory is missing or empty

*  the file is context.help in the system directory (so the installer's internal session, which has no LOGTO, can make it, and an account cannot reach it without the
*  OS switches).  It is made only from a session whose directory IS the system directory; a session in sduser (ADMIN, then LOAD.HELP) uses the file that is there
   hpath = @sdsys : @ds : 'context.help'
   openpath hpath to hf else
*     26 Oct 26: the installer's internal session does not stand in the system directory (its @path is the folder it was started in), so the old test
*     "is this session's directory the system directory" never held and the file was never made.  The file is made INTO the system directory by name,
*     and the VOC pointer CREATE.FILE writes in the session's account is removed again (an account reaches the file only through the OS switches).
      execute 'create.file context.help dynamic directory ' : @sdsys capturing mk
      openpath hpath to hf else stop sysmsg(12843)               ;* Could not make the file context.help
      open 'VOC' to vf then
         read vrec from vf, 'context.help' then
            if vrec<1>[1, 1] = 'F' then delete vf, 'context.help'
         end
         close vf
      end
   end

   shipped = ''
   n.new = 0
   n.changed = 0
   n.same = 0
   n.bad = 0
   for i = 1 to dcount(entries, @fm)
      name = entries<i, 1>
      if entries<i, 2> # 'F' then continue
      gosub load.one
   next i

   n.kept = 0
   select hf to 12
   loop
      readnext rid from 12 else exit
      locate rid in shipped<1> setting p else n.kept += 1
   repeat
   close hf

   void kernel(K$AUDIT, 'load.help new=' : n.new : ' changed=' : n.changed : ' same=' : n.same : ' skipped=' : n.bad)
   display sysmsg(12844, n.new, n.changed, n.same, n.kept)           ;* SYSMSG takes four places
   @system.return.code = (if n.bad then -ER$FAILED else 0)
   stop

* One file of the helptext directory
load.one:
   ok = (len(name) >= 1 and len(name) <= 80 and index('abcdefghijklmnopqrstuvwxyz0123456789', name[1, 1], 1) > 0)
   if ok then
      for ci = 2 to len(name)
         if index(keychars, name[ci, 1], 1) = 0 then ok = 0
      next ci
   end
   if not(ok) then
      display sysmsg(12845, name, 'not a key')
      n.bad += 1
      return
   end
   rec = ''
   nf = 0
   got = 0
   openseq src : @ds : name readonly to sf then
      got = 1
      loop
         readseq ln from sf else exit
         nf += 1
         rec<nf> = trimb(ln)
      repeat
      closeseq sf
   end
   if not(got) then
      display sysmsg(12845, name, 'cannot be read')
      n.bad += 1
      return
   end
   if rec<1> = '' then
      display sysmsg(12845, name, 'has no title')
      n.bad += 1
      return
   end
   shipped<-1> = name
   old = ''
   read old from hf, name then
      if old = rec then
         n.same += 1
         return
      end
      n.changed += 1
   end else
      n.new += 1
   end
   wok = @true
   write rec to hf, name on error wok = @false
   if not(wok) then
      display sysmsg(12846, name)
      n.bad += 1
   end
   return
end

* END-CODE
