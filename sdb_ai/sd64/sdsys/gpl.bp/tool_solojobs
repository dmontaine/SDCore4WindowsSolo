* START-HISTORY:
* 20 Nov 26 SD Core Solo - RELEASE_1.1 365 (Linux Solo 6aea37f, S.277): the N / C form's labels are "Schedule" and "Command" (both were cut at 28 cells)
*           and the schedule entry 20 cells, so "default: daily 02:30" fits beside it; the schedule's forms are said under the entries when the form opens
*           (SCHED.FORMS; Linux 14114 is 15114).
* 20 Nov 26 SD Core Solo - SOLO 74: the page's text says what a job is now - its definition, run by the job clock (one task); no per-job task.
* 17 Nov 26 dm  New (S.247; owner, 15 Nov 2026: "since scheduled jobs is in core and useful in solo it should be in this release", and of the plan, "your plan is fine",
*               whose step 4 is "a tool.jobs page for Solo shaped like Core's Jobs view (one account)").  Made from SD Core's tool_jobs, its Jobs view only: Solo has
*               no batch gate (LSOLO 6) and one account, so there is no Account commands view.  What differs from the template is forced by Solo: the jobs are the
*               person's own (set.job), a job's command is any SD command they type, and making or changing one needs the account password, typed in the form.
*               A program of its own name (Core's tool_jobs cites Core's messages), listed for the parity audit.
* 16 Nov 26 Windows port - from Linux Solo 2d3db81 (S.247): carried as it is but for the platform's facts - a job is a Task Scheduler task that
*               runs as the Windows user whether or not that user is signed in (SET.JOB and the doors helper make it), so the words say so; the
*               hand-over folder is made with OSPATH and taken only when SD_FILE_PRIVATE says it is this Windows user's alone (Linux: umask 077,
*               mkdir, chmod 700), and the file is removed with DELETESEQ; the messages are Windows Solo's (15948, 15942, 15045, 12826).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.JOBS
*
*   For every session of the account (the jobs are the person's own).  A full-screen page, in the toolkit's frame (140 columns by 43 lines at least), with one box:
*   the jobs SET.JOB lists - each one's name, schedule, command, when it runs next and how its last run ended - and whether jobs are on (SET.JOBS.ACCESS, the
*   administrator's switch; off as delivered, and then nothing can be made or run).  N makes a job, C changes the selected one's schedule or command, D deletes it (its
*   name is typed in the box) and R starts it now.
*
*   N AND C ASK FOR THE ACCOUNT PASSWORD in the form's masked field, every time.  A job's command may hold spaces and quotes, which no $tk_run word can carry, so the
*   page writes the action, the name, the schedule, the command and the password to its hand-over file (@sdsys/$jobsho/req, a folder of the Windows user's alone) and runs
*   SET.JOB HANDOVER, which reads and removes the file and checks everything again exactly as if it had been typed; the page removes the file itself only when
*   writing it failed.  The password is never shown or kept.
*
*   Keys: Up and Down move, PgUp and PgDn a page, Enter or C changes, N new, D delete, R run now, '/' finds a row, F5 reads the jobs again, F1 or ? explains the
*   box, Ctrl-O the output pane, Ctrl-Q leaves; Esc or F10 opens the menu bar (File, Job, View, Help).
*
*   THE PAGE WRITES NO JOB ITSELF: every change is SET.JOB, shown with its effect in a box answered Run or Cancel (Cancel is what Enter chooses), and run by $tk_run.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_solojobs
$catalog $tool_solojobs

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'set.job'                                             ;* the one command this page may run
   MAXCMD = 500
   DAYS = 'mon' : @fm : 'tue' : @fm : 'wed' : @fm : 'thu' : @fm : 'fri' : @fm : 'sat' : @fm : 'sun'
   SCHED.FORMS = 'Schedule: every 5|10|15|20|30 minutes, hourly, daily hh:mm, weekly mon..sun hh:mm or monthly 1..28 hh:mm (hh:mm as 09:30).'

   call $tk_open('tool.jobs', '', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.jobs')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'n', 'new job', 'jnew', '', 1)
   call $tk_keys('add', keys, 'c', 'change job', 'jchange', '', 1)
   call $tk_keys('add', keys, 'd', 'delete job', 'jdelete', '', 1)
   call $tk_keys('add', keys, 'r', 'run now', 'jrun', '', 1)
   call $tk_keys('add', keys, '/', 'find', 'find', '', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'ctrl-o', 'output', 'output', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'jnew', '&Job', '&New job', '', '')
   call $tk_keys('menu', keys, 'jchange', '&Job', '&Change the job', '', '')
   call $tk_keys('menu', keys, 'jdelete', '&Job', '&Delete the job', '', '')
   call $tk_keys('menu', keys, 'jrun', '&Job', '&Run the job now', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'find', '&View', '&Find a row', '', '')
   call $tk_keys('menu', keys, 'output', '&View', '&Output', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this box', '', '')
   call $tk_std('keys', ctx, keys, '', '')
*  The AI line: offered only the output pane and refresh; no job action is offered (a proposal is carried out by the page's own key).
   call $tk_keys('ai', keys, 'output', '', '', '', '')
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')
   call $tk_aipage('init', ctx, keys, '', '', aout)

   pnames = 'Jobs'
   pane = 1
   JVIS = 16
   ji = 1 ; jtop = 1
   find.last = ''
   jn = 0 ; jnm = '' ; jsch = '' ; jcmd = '' ; jnext = '' ; jlast = '' ; jerr = '' ; jon = ''
   gen = 0
   msg = ''
   done = 0
   outopen = 0

   perr = ''
   gosub declare.layout
   gosub read.jobs
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, pnames<pane>, '', '', mr)
      call $tk_frame(ctx, keys, pnames<pane>, msg)
      call $tk_aipage('cursor', ctx, '', '', '', '')
      nm = ''
      screen key returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, pnames<pane>, nm, ao)
      if ao<1> = 'replay' then nm = ao<2>
      if ao<1> # '' then msg = ao<4>
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, pnames<pane>, nm, outopen, mr)
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', chg)
            gosub get.rects
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the system says

* The jobs as SET.JOB lists them.  Lines:
*   SD's scheduled jobs (set.job, run.job) may be made and run: yes|no
*   job NAME: SCHEDULE: COMMAND               followed by   next run: X; last run: Y
* The name ends at the first ': ' (a name has none), the schedule at the next (a schedule holds hh:mm, never ': '); the command is the rest, as typed.
read.jobs:
   old.job = (if ji >= 1 and ji <= jn then jnm<ji> else '')
   jnm = '' ; jsch = '' ; jcmd = '' ; jnext = '' ; jlast = '' ; jerr = '' ; jon = ''
   jn = 0
   call $tk_run(allow, 'set.job', jout, jst, jrerr)
   jout = change(change(jout, char(13) : char(10), @fm), char(13), '')
   if jrerr # '' then
      jerr = jrerr
   end else
      if jst # 0 then jerr = trim(change(jout, @fm, '  '))
   end
   if jerr = '' then
      for i = 1 to dcount(jout, @fm)
         ln = jout<i>
         tl = trim(ln)
         begin case
            case index(ln, ' may be made and run: ', 1) > 0
               jon = trim(field(ln, ': ', dcount(ln, ': ')))
            case ln[1, 4] = 'job '
               rest = ln[5, len(ln)]
               p = index(rest, ': ', 1)
               if p > 0 then
                  jn += 1
                  jnm<jn> = rest[1, p - 1]
                  rest = rest[p + 2, len(rest)]
                  p = index(rest, ': ', 1)
                  jsch<jn> = (if p > 0 then rest[1, p - 1] else rest)
                  jcmd<jn> = (if p > 0 then rest[p + 2, len(rest)] else '')
                  jnext<jn> = '' ; jlast<jn> = ''
               end
            case tl[1, 10] = 'next run: ' and jn > 0
               t = tl[11, len(tl)]
               p = index(t, '; last run: ', 1)
               if p > 0 then
                  jnext<jn> = t[1, p - 1]
                  jlast<jn> = t[p + 12, len(t)]
               end
         end case
      next i
   end
   ji = 1
   if old.job # '' then
      locate old.job in jnm<1> setting op then ji = op
   end
   if ji > jn then ji = jn
   if ji < 1 then ji = 1
   gosub keep.tops
   return

keep.tops:
   if ji < jtop then jtop = ji
   if ji > jtop + JVIS - 1 then jtop = ji - JVIS + 1
   if jtop < 1 then jtop = 1
   return

* ------------------------------------------------------------------------------------------------- drawing

* The jobs across the body, the explanation and the help under them; with the output pane open the explanation gives it 6 rows.  One box takes the focus.
declare.layout:
   ctx<TK.C.FOCI> = ''
   d = ''
   d<1> = 'jobs' : @vm : 1 : @vm : 1 : @vm : 20 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   if outopen then
      d<2> = 'means' : @vm : 2 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
      d<3> = 'output' : @vm : 3 : @vm : 1 : @vm : 6 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
      d<4> = 'help' : @vm : 4 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   end else
      d<2> = 'means' : @vm : 2 : @vm : 1 : @vm : 11 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
      d<3> = 'help' : @vm : 3 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   end
   call $tk_layout('declare', ctx, d, perr)
   gosub get.rects
   return

toggle.out:
   call $tk_out('toggle', ctx, '', '', oc)
   outopen = oc
   gosub declare.layout
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

get.rects:
   call $tk_layout('pane', ctx, 'jobs', rc)
   j.x = rc<1, 1> ; j.y = rc<1, 2> ; j.w = rc<1, 3> ; j.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'means', rc)
   m.x = rc<1, 1> ; m.y = rc<1, 2> ; m.w = rc<1, 3> ; m.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'help', rc)
   h.x = rc<1, 1> ; h.y = rc<1, 2> ; h.w = rc<1, 3> ; h.h = rc<1, 4>
   m.tw = m.w - 4
   h.tw = h.w - 4
   JVIS = j.h - 4                                                ;* the header row, the rows, a blank row and the border
   gosub keep.tops
   return

draw.all:
   screen clear at 0,ctx<TK.C.YBODY> size ctx<TK.C.W>,ctx<TK.C.BODYH>
   screen box at j.x,j.y size j.w,j.h title 'Scheduled jobs' : (if jon = 'yes' then '' else ' (off: the administrator turns them on)')
   screen box at m.x,m.y size m.w,m.h title 'What this means'
   screen box at h.x,h.y size h.w,h.h title 'Help'
   gosub draw.jobs
   gosub draw.effect
   gosub draw.help
   if outopen then call $tk_out('draw', ctx, 'output', '', oc)
   return

* Name 20, schedule 18, command 40, next run 28, last run the rest (130 columns at 140 by 43)
draw.jobs:
   tw = j.w - 8
   ex = j.w - 138
   screen text fmt('Job', '20L') : fmt('Schedule', '18L') : fmt('Command', '40L') : fmt('Next run', '28L') : 'Last run' at j.x + 2,j.y + 1 attr 'header' width tw
   for r = 1 to JVIS
      k = jtop + r - 1
      s = ''
      if k <= jn then
         s = fmt(jnm<k>[1, 19], '20L') : fmt(jsch<k>[1, 17], '18L') : fmt(jcmd<k>[1, 39], '40L') : fmt(jnext<k>[1, 27], '28L') : jlast<k>[1, 24 + ex]
      end
      screen text s at j.x + 2,j.y + 1 + r attr (if k = ji and k <= jn then 'highlight' else 'normal') width tw
   next r
   if jerr # '' then
      screen text 'The jobs could not be read:' at j.x + 2,j.y + 3 width tw
      call $tk_wrap(jerr, tw, pieces)
      for r = 1 to dcount(pieces, @fm)
         if r <= JVIS - 2 then screen text pieces<r> at j.x + 2,j.y + 3 + r width tw
      next r
   end else
      if jn = 0 then screen text (if jon = 'yes' then 'No job is scheduled.  N makes one.' else 'No job is scheduled, and jobs are off: the administrator turns them on with set.jobs.access on.') at j.x + 2,j.y + 3 width tw
   end
   call $tk_help('mark', j.x + j.w - 5, j.y + 1, 0, 0)
   return

draw.effect:
   lines = ''
   sel = ''
   if jn > 0 then
      sch = jsch<ji>
      gosub sched.words
      sel = 'Selected: ' : jnm<ji> : ' runs ' : jcmd<ji> : ' ' : sw : '.  Next run: ' : jnext<ji> : '.  Last run: ' : jlast<ji> : '.'
   end
   if outopen and sel # '' then lines<-1> = sel
   lines<-1> = 'A scheduled job runs one SD command of yours, unattended, as your Windows user, whether or not you are signed in: the job clock, one Task Scheduler task,'
   lines<-1> = 'starts sd-solo.exe run.jobs.due every minute, which signs in as a one-shot command (signed out, by its Windows identity) and runs each job whose time has come.'
   lines<-1> = 'Making or changing a job asks for your account password.  Jobs are off as delivered: the administrator turns them on (set.jobs.access on), and off stops every job.'
   lines<-1> = "A run missed while the computer is off is not made up.  Jobs run while SD runs, which its startup task starts at boot.  Times are the computer's."
   lines<-1> = ''
   if not(outopen) and sel # '' then lines<-1> = sel
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      call $tk_wrap(lines<wi>, m.tw, pieces)
      wrapped<-1> = pieces
   next wi
   lines = wrapped
   for r = 1 to m.h - 3
      screen text lines<r> at m.x + 2,m.y + 1 + r width m.tw
   next r
   return

draw.help:
   screen text 'Up and Down move, PgUp and PgDn a page.  N makes a job, C (or Enter) changes it, D deletes it, R runs it now.  F1 or ? explains the box.' at h.x + 2,h.y + 1 width h.tw
   screen text 'Each change is shown as its command; you answer Run or Cancel.  N and C ask for your account password; a delete asks for the job' : "'s name." at h.x + 2,h.y + 2 width h.tw
   screen text 'F5 reads the jobs again.  Ctrl-Q leaves.' at h.x + 2,h.y + 3 width h.tw
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   begin case
      case nm = 'up'
         if ji > 1 then
            ji -= 1
            gosub redraw
         end
      case nm = 'down'
         if ji < jn then
            ji += 1
            gosub redraw
         end
      case nm = '/'
         call $tk_findrow(jnm, ji, find.last, fpos)
         if fpos < 0 then msg = sysmsg(15045, find.last)
         if fpos > 0 then
            ji = fpos
            gosub redraw
         end
      case (nm = 'pgup' or nm = 'pgdn') and not(outopen)
         if jn > 0 then
            ji = ji + (if nm = 'pgup' then 0 - JVIS else JVIS)
            if ji < 1 then ji = 1
            if ji > jn then ji = jn
            gosub redraw
         end
      case nm = 'n'
         gosub job.new
      case nm = 'c' or nm = 'enter' or nm = ' '
         gosub job.change
      case nm = 'd'
         gosub job.delete
      case nm = 'r'
         gosub job.run
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'ctrl-t'
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'
         call $tk_std('keylist', ctx, keys, pnames<pane>, std.r)
      case nm = 'f5'
         gosub read.jobs
         gosub draw.all
         msg = 'read the jobs again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, 1, nm : @fm : 1, ap)      ;* one box: F6 / Shift-F6 go to the AI line and back
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
      case nm = 'ctrl-o'
         gosub toggle.out
      case nm = 'esc'
         if outopen then gosub toggle.out
      case (nm = 'pgup' or nm = 'pgdn') and outopen
         call $tk_out('key', ctx, nm, '', oc)
         call $tk_out('draw', ctx, 'output', '', oc)
   end case
   return

redraw:
   gosub keep.tops
   gosub draw.jobs
   gosub draw.effect
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key
      return
   end
   call $tk_aipage('mouse', ctx, keys, pnames<pane>, mev, ap)
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, j.x + j.w - 5, j.y + 1, hit.jobs)
   if hit.jobs then
      gosub help.here
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      if mx >= j.x + 1 and mx <= j.x + j.w - 2 and my >= j.y + 2 and my <= j.y + 1 + JVIS then
         k = jtop + my - j.y - 2
         if k <= jn then ji = k
         gosub redraw
      end
   end
   return

help.here:
   call $tk_help('box', 'tool.jobs.page', hm, 0, 0)
   if hm # '' then msg = hm
   return

* ------------------------------------------------------------------------------------------------- changing something

* sent in: $tk_run, then what it answered on the status line and in the output pane (the last line the command printed)
run.sent:
   call $tk_run(allow, sent, out, st, err)
   if err # '' then
      msg = err
      call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')
      return
   end
   out = change(change(out, char(13) : char(10), @fm), char(13), '')
   said = ''
   for oi = dcount(out, @fm) to 1 step -1
      if said = '' and trim(out<oi>) # '' then said = trim(out<oi>)
   next oi
   msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
   okind = (if st = 0 then 'ok' else 'refuse')
   call $tk_out('add', ctx, okind, sent : '  ' : trim(change(out, @fm, ' ')), '')
   return

* N: the name, the schedule, the command and the password, on one form; the page checks them before it shows the box (set.job checks them again)
job.new:
   if jerr # '' then
      msg = 'the jobs could not be read, so none can be made from here (F5 reads them again)'
      return
   end
   if jon # 'yes' then
      msg = sysmsg(15948)                                        ;* Scheduled jobs are off on this computer ...
      return
   end
   fmode = 'add'
   fname = ''
   spec = 'New scheduled job' : @fm : '&Next' : @fm : ''
   spec<-1> = 'name' : @vm : 'Name (a-z 0-9 -)' : @vm : 34 : @vm : 32
   gosub job.fields
   fv = '' : @fm : 'daily 02:30' : @fm : '' : @fm : ''
   gosub job.form
   if not(fok) then return
   gosub job.confirm
   return

* C: the same form for the selected job, its name fixed (a job is renamed by making the new one and deleting the old)
job.change:
   if jn = 0 then
      msg = 'there is no job to change: N makes one'
      return
   end
   if jon # 'yes' then
      msg = sysmsg(15948)
      return
   end
   fmode = 'change'
   fname = jnm<ji>
   spec = 'Change the job ' : fname : @fm : '&Next' : @fm : ''
   gosub job.fields
   fv = jsch<ji> : @fm : jcmd<ji> : @fm : ''
   gosub job.form
   if not(fok) then return
   gosub job.confirm
   return

* The schedule, the command and the password fields (S.244: the entries open empty, the value in force beside them, an empty entry keeping it; the password masked)
job.fields:
* 20 Nov 26 (RELEASE_1.1 365, Linux Solo 6aea37f): one-word labels and a 20-cell schedule entry - the form cuts a label at 28 cells and the shown value
*   at the cells the entry leaves.  The forms of a schedule are said under the entries when the form opens (job.form).
   spec<-1> = 'sched' : @vm : 'Schedule' : @vm : 20 : @vm : 24 : @vm : '' : @vm : 1 : @vm : '' : @vm : (if fmode = 'add' then 'default' else 'now')
   spec<-1> = 'cmd' : @vm : 'Command' : @vm : 100 : @vm : MAXCMD : @vm : '' : @vm : (if fmode = 'add' then '' else 1)
   spec<-1> = 'pw' : @vm : 'Account password' : @vm : 34 : @vm : 64 : @vm : 1
   return

* spec, fv, fmode, fname in; fok, fname, fsch (hh:mm), fcmd, fpw out.  The form stays until the answers pass or it is cancelled.
job.form:
   fok = 0
   fpw = ''
   call $tk_form('open', ctx, spec, fv, fo)
   if fo = 'no' then
      msg = 'the form does not fit this window'
      return
   end
   ftext = SCHED.FORMS : ' ' : sysmsg(15114)
   call $tk_form('say', ctx, ftext, '', '')    ;* the schedule's forms, under the entries until a refusal replaces them
   loop
      call $tk_form('run', ctx, fans, fv, fid)
      if fans # 'ok' then
         call $tk_form('close', ctx, '', '', '')
         msg = sysmsg(12826)                                     ;* nothing was run
         return
      end
      if fmode = 'add' then
         fname = downcase(trim(fv<1>))
         fsch = downcase(trim(fv<2>))
         fcmd = trim(fv<3>)
         fpw = fv<4>
      end else
         fsch = downcase(trim(fv<1>))
         fcmd = trim(fv<2>)
         fpw = fv<3>
      end
      fv = ''
      fsch = trim(change(fsch, '.', ':'))
      fbad = ''
      fid = ''
      jname = fname
      gosub name.ok
      sch = fsch
      gosub sched.words
      jcm = fcmd
      gosub cmd.ok
      begin case
         case not(nok)
            fbad = 'a job name is 1 to 32 characters: a lower case letter first, then lower case letters, digits and dashes, not ending in a dash' ; fid = 'name'
         case fmode = 'add' and jn > 0 and index(@fm : jnm : @fm, @fm : fname : @fm, 1) > 0
            fbad = 'a job named ' : fname : ' exists: C changes it' ; fid = 'name'
         case sw = ''
            fbad = 'the schedule is every 5|10|15|20|30 minutes, hourly, daily hh:mm, weekly mon..sun hh:mm or monthly 1..28 hh:mm' ; fid = 'sched'
         case not(cok)
            fbad = sysmsg(15942) ; fid = 'cmd'                   ;* A job's command is one line of printable characters ...
         case fpw = ''
            fbad = 'type your account password: a job is made or changed only with it' ; fid = 'pw'
      end case
      if fbad = '' then exit
      fpw = ''
      call $tk_form('say', ctx, fbad, fid, '')
   repeat
   call $tk_form('close', ctx, '', '', '')
   fok = 1
   return

* The box for N and C: the sentence as it could be typed (without the password), the command and the schedule in words; on Run, the hand-over and SET.JOB HANDOVER
job.confirm:
   sent = 'set.job ' : fmode : ' ' : fname : ' ' : fsch : ' ' : fcmd
   sch = fsch
   gosub sched.words
   el = ''
   el<-1> = 'The job ' : fname : ' will run ' : fcmd : ' as your Windows user, unattended, signed in or not, ' : sw : " (the computer's time)."
   if fmode = 'change' then el<-1> = 'It replaces what ' : fname : ' does now: ' : jcmd<ji> : ' ' : jsch<ji> : '.'
   el<-1> = 'The job clock (one task, \SD Core Solo Jobs\sd-solo-jobs-clock) runs it; the command is kept in SD.  A run missed while the computer is off is not made up.'
   call $tk_confirm(sent, el, '', res, cmsg)
   if res # 'run' then
      fpw = ''
      msg = cmsg
      return
   end
   gosub hand.over
   if ho.err # '' then
      msg = ho.err
      call $tk_out('add', ctx, 'refuse', sent : '  ' : ho.err, '')
   end else
      sent = 'set.job handover'
      gosub run.sent
   end
   gosub read.jobs
   if fmode = 'add' then
      locate fname in jnm<1> setting op then ji = op
      gosub keep.tops
   end
   gosub draw.all
   return

* fmode, fname, fsch, fcmd, fpw in; ho.err out (null when the file was written).  The hand-over file SET.JOB HANDOVER reads and removes: the folder
* @sdsys/$jobsho is made (it takes the tree's ACL: the Windows user, SYSTEM and Administrators) and used only when SD_FILE_PRIVATE says it is this
* Windows user's alone, before the file is written in it.  fpw is cleared here; SET.JOB removes the file whatever happens.
hand.over:
   ho.err = ''
   hdir = @sdsys : @ds : '$jobsho'
   hf = hdir : @ds : 'req'
   if not(ospath(hdir, OS$EXISTS)) then void ospath(hdir, OS$MKDIR)
   if SDEXT(hdir : @FM : 'DIR', @TRUE, SD_FILE_PRIVATE) # '1' then
      ho.err = "the hand-over folder is a link, or is not this Windows user's alone"
      fpw = ''
      return
   end
   deleteseq hf else null
   openseq hf to kf else
      if status() then
         ho.err = 'the hand-over file could not be made'
         fpw = ''
         if not(unassigned(kf)) then close kf
         return
      end
   end
   writeseq fmode to kf else ho.err = 'the hand-over file could not be written'
   writeseq fname to kf else ho.err = 'the hand-over file could not be written'
   writeseq fsch to kf else ho.err = 'the hand-over file could not be written'
   writeseq fcmd to kf else ho.err = 'the hand-over file could not be written'
   writeseq fpw to kf else ho.err = 'the hand-over file could not be written'
   close kf
   fpw = ''
   if ho.err # '' then deleteseq hf else null
   return

* D: the name is typed in the box
job.delete:
   if jn = 0 then
      msg = 'there is no job to delete'
      return
   end
   fname = jnm<ji>
   jname = fname
   gosub name.ok
   if not(nok) then
      msg = 'This name cannot be sent from the page: at the prompt, set.job delete ' : fname
      return
   end
   sent = 'set.job delete ' : fname
   sch = jsch<ji>
   gosub sched.words
   el = ''
   el<-1> = 'The job ' : fname : ' stops: its definition is removed, so the job clock runs it no more.  It ran ' : jcmd<ji> : ' ' : sw : '.'
   el<-1> = 'A run already going finishes.  Type the name of the job to delete it.'
   call $tk_confirm(sent, el, fname, res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.jobs
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* R: start the job now, exactly as its task would; the page does not wait for it
job.run:
   if jn = 0 then
      msg = 'there is no job to run'
      return
   end
   if jon # 'yes' then
      msg = sysmsg(15948)
      return
   end
   fname = jnm<ji>
   jname = fname
   gosub name.ok
   if not(nok) then
      msg = 'This name cannot be sent from the page: at the prompt, set.job run ' : fname
      return
   end
   sent = 'set.job run ' : fname
   el = ''
   el<-1> = 'Starts the job ' : fname : ' now: ' : jcmd<ji> : ', as your Windows user, through the job clock, as a scheduled run would.  Its schedule is not changed.'
   el<-1> = 'The page does not wait for it: F5 shows when it has finished, under Last run.'
   call $tk_confirm(sent, el, '', res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.jobs
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* ------------------------------------------------------------------------------------------------- the checks set.job makes again

* jname in; nok out: SD Core's rule
name.ok:
   nok = 0
   if len(jname) < 1 or len(jname) > 32 then return
   if index('abcdefghijklmnopqrstuvwxyz', jname[1, 1], 1) = 0 then return
   if jname[len(jname), 1] = '-' then return
   if convert('abcdefghijklmnopqrstuvwxyz0123456789-', '', jname) # '' then return
   nok = 1
   return

* jcm in; cok out: one line of printable ASCII, not empty, at most MAXCMD, and not a job verb itself (set.job's rule)
cmd.ok:
   cok = 0
   if jcm = '' or len(jcm) > MAXCMD then return
   for ci = 1 to len(jcm)
      cc = seq(jcm[ci, 1])
      if cc < 32 or cc > 126 then return
   next ci
   cw = downcase(field(trim(jcm), ' ', 1))
   if cw = 'run.job' or cw = 'set.job' then return
   cok = 1
   return

* sch in (hh:mm); sw out: the schedule in words, or null when it is none of the five shapes
sched.words:
   sw = ''
   if convert('abcdefghijklmnopqrstuvwxyz0123456789: ', '', sch) # '' then return
   ns = dcount(sch, ' ')
   s1 = field(sch, ' ', 1)
   s2 = field(sch, ' ', 2)
   s3 = field(sch, ' ', 3)
   begin case
      case s1 = 'every'
         if ns = 3 and s3 = 'minutes' and index(' 5 10 15 20 30 ', ' ' : s2 : ' ', 1) > 0 and s2 # '' then sw = 'every ' : s2 : ' minutes'
      case s1 = 'hourly'
         if ns = 1 then sw = 'every hour, on the hour'
      case s1 = 'daily'
         tm = s2
         gosub time.ok
         if ns = 2 and tok then sw = 'every day at ' : tm
      case s1 = 'weekly'
         tm = s3
         gosub time.ok
         locate s2 in DAYS<1> setting dx else dx = 0
         if ns = 3 and tok and dx > 0 then sw = 'every ' : field('Monday Tuesday Wednesday Thursday Friday Saturday Sunday', ' ', dx) : ' at ' : tm
      case s1 = 'monthly'
         tm = s3
         gosub time.ok
         dd = (if s2 matches '1N' or s2 matches '2N' then s2 else '')
         dok = 0
         if dd # '' then
            if dd[1, 1] # '0' and dd >= 1 and dd <= 28 then dok = 1
         end
         if ns = 3 and tok and dok then sw = 'on day ' : dd : ' of every month at ' : tm
   end case
   return

* tm in; tok out: hh:mm, 00:00 to 23:59
time.ok:
   tok = 0
   if len(tm) # 5 or tm[3, 1] # ':' then return
   hh = tm[1, 2]
   mm = tm[4, 2]
   if not(hh matches '2N') or not(mm matches '2N') then return
   if hh > 23 or mm > 59 then return
   tok = 1
   return

end

