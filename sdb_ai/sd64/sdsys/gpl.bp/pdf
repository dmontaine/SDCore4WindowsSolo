* START-HISTORY:
* 9 Nov 26 Windows port - from Linux Solo 15767b9 (SOLO 47, the owner: "the windows solo should get pdf").  No find and no nohup: the documents are listed with DIR(), the viewer is started with Start-Process
*               by one PowerShell line, and the display test is "not an ssh session and not session 0".  The message ids are Linux's plus 1005.
* 23 Oct 26 dm  New (S.75; the owner: "a verb pdf that will display the file in the installed pdf reader ... available even if os.execute is not allowed for the
*               account as a system bypass").
* 23 Oct 26 dm  SOLO CARRY 14 (Core 72e708e): the documents are in the pdf directory of the SD system directory, not of a shared account (Solo has none).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   PDF            lists the documents (the PDF files in the pdf directory of the SD system directory; SD Core keeps them in the shared account, Solo has none)
*   PDF name       opens name.pdf in the viewer the administrator has allowed (SET.VIEWER)
*
*   THIS IS A BYPASS OF ONE THING.  It starts a program outside SD for an account whose OS.EXECUTE switch is off, which is why it is $internal and why it is
*   narrow.  Two commands are run, no more: the viewer test (!VIEWLIST) and the start of the viewer.  What it will start, and with what:
*     1  the program is the first one on the administrator's list for pdf (!VIEWLIST) that passes !VIEWLIST's test AGAIN now (an .exe under Program Files or the Windows folder, a regular file,
*        owned by SYSTEM, the Administrators or TrustedInstaller, that no ordinary user can write).  The list is EMPTY as delivered, so this verb says that no viewer has
*        been allowed until the administrator names one;
*     2  the file is a REGULAR file (not a link or reparse point, checked again by the start line) of the pdf directory of the system directory, named by the caller with a-z 0-9 dot dash underscore, not
*        starting with a dot, up to 80 characters, with .pdf added.  The caller never supplies a path;
*     3  the program gets that one file as its one argument, in quotes, started with Start-Process (it does not wait for the viewer);
*     4  a session that is not at the computer (an ssh session, or session 0) is refused in words, not tried;
*     5  one audit line:  pdf open file=name viewer=path.
*   It does not look at the account's OS switches and it is not an account gate; the administrator's list is the control.  A graphical reader can itself open other
*   files its user may read and follow links, so naming one is the administrator's judgement.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program pdf
$catalog $pdf

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS

   words = trim(@sentence)
   if dcount(words, ' ') > 2 then stop sysmsg(12848)             ;* pdf {name}

* The directory of documents: the pdf directory of the SD system directory (Solo has no shared account)
   pdfdir = @sdsys : @ds : 'pdf'
   call !viewlist('native', @sdsys, sysn, 0)
   if sysn = '' then stop sysmsg(12893)                            ;* There are no documents
   entries = dir(pdfdir)
   docs = ''
   for i = 1 to dcount(entries, @fm)
      nm = entries<i, 1>
      if entries<i, 2> # 'F' then continue
      if nm = downcase(nm) and nm[len(nm) - 3, 4] = '.pdf' and nm[1, 1] # '.' then docs<-1> = nm[1, len(nm) - 4]
   next i
   if docs = '' then stop sysmsg(12893)

   if dcount(words, ' ') = 1 then
      listed = ''
      for i = 1 to dcount(docs, @fm)
         locate docs<i> in listed<1> by 'AL' setting p else
            ins docs<i> before listed<p>
         end
      next i
      display sysmsg(12892, dcount(listed, @fm))                  ;* Documents (%1); pdf name opens one:
      for i = 1 to dcount(listed, @fm)
         display '  ' : listed<i>
      next i
      @system.return.code = 0
      stop
   end

* The name
   name = downcase(field(words, ' ', 2))
   if name[len(name) - 3, 4] = '.pdf' then name = name[1, len(name) - 4]
   ok = (len(name) >= 1 and len(name) <= 80 and name[1, 1] # '.')
   if ok then
      if trim(convert('abcdefghijklmnopqrstuvwxyz0123456789._-', space(39), name)) # '' then ok = 0
   end
   if not(ok) then
      shown = field(words, ' ', 2)
      stop sysmsg(12849, shown[1, 60])                              ;* %1 is not a document name
   end
   locate name in docs<1> setting dp else stop sysmsg(12850, name)     ;* There is no document %1
   docfile = sysn : '/pdf/' : name : '.pdf'

* The viewer
   call !viewlist('get', 'pdf', paths, 0)
   viewer = ''
   why = ''
   for i = 1 to dcount(paths, @fm)
      if viewer = '' then
         call !viewlist('check', paths<i>, why, 0)
         if why = '' then viewer = paths<i>
      end
   next i
   if viewer = '' then
      if paths = '' then stop sysmsg(12851)                       ;* No viewer has been allowed
      stop sysmsg(12854, paths<1>, why)                           ;* The viewer %1 cannot be used: %2
   end

* Only a session at the computer can show a window
   if env('SSH_CONNECTION') # '' or env('SSH_CLIENT') # '' then stop sysmsg(12852)

* One line of PowerShell, single quotes only.  The two names are plain (the viewer passed the test, the document is sysn + a checked name), so nothing in them can end a quoted word.
   ps = "$ErrorActionPreference='Stop'; try { $d='" : docfile : "'.Replace('/','\'); if ((Get-Process -Id $PID).SessionId -eq 0) { 'NODISPLAY' } else { $i=Get-Item -LiteralPath $d -Force; "
   ps := "if ($i.PSIsContainer -or (($i.Attributes -band 1024) -ne 0)) { 'it is not a regular file' } else { $q=[char]34; "
   ps := "Start-Process -FilePath ('" : viewer : "'.Replace('/','\')) -ArgumentList ($q+$d+$q); 'OK' } } } catch { 'it could not be started' }"
   os.execute ps capturing out
*  Captured PowerShell output keeps its carriage return and line feed (EDIT:702 strips them): the answer is compared after they and the field marks are spaces.
   res = trim(convert(char(13) : char(10) : @fm, '   ', out))
   if res = 'NODISPLAY' then stop sysmsg(12852)
   if res # 'OK' then
      if res = '' then res = 'it could not be started'
      stop sysmsg(12854, viewer, res)
   end
   @system.return.code = 0
   void kernel(K$AUDIT, 'pdf open file=' : name : ' viewer=' : viewer)
   display sysmsg(12853, name, viewer)                            ;* Opened %1 with %2
   stop
end

* END-CODE
