* START-HISTORY:
* 15 Nov 26 SD Core Solo for Linux - written (the Solo carry of SD Core's S.242, file transfer over the ssh login).  THE OWNER'S WORDS, 15 Nov
*           2026: "yes solo needs the same file transfer capabilities", then, of the switch's name, "Yes, set.xfer.access".  Solo's own, like
*           SET.NET.ACCESS (PAL-33): SD Core has MODIFY.ACCOUNT XFER-ON / XFER-OFF for many accounts, and Solo has one account and no such verb.
*           A DEVIATION FROM THE LINUX CORE TEMPLATE WITH THE OWNER'S SPECIFIC PERMISSION (the verb's name and shape), listed for the parity audit.
* 15 Nov 26 SD Core Solo - RELEASE_1.1 299: carried from Linux Solo 9b69caa as it is; messages 15074 and 15949 (Linux's 14074 and 14949 + 1000).
* END-HISTORY
*
* START-DESCRIPTION:
*
*    SET.XFER.ACCESS          shows the state of the account's file transfer switch and changes nothing
*    SET.XFER.ACCESS ON       lets the account's person move plain-text files in and out with RECEIVE and SEND, once sd.conf's XFER is 1
*    SET.XFER.ACCESS OFF      takes that back
*
*    An administrator verb (ADMIN first), and ONE word per command.  The switch is OFF as delivered.  It is field 22 of the register record
*    accounts/sduser (ACC$XFER), 'yes' or 'no'; ONLY 'yes' is on, so a blank field, or a record with fewer fields, is off.  RECEIVE / SEND and
*    the transfer server (xfersrv) read the record when they are used, at every connection, so a change is seen by the next transfer of a
*    session that is already running.  Fields 9 to 14 are SD Core's and are empty in a record written with field 22.
*
*    The answer is the state afterwards (15074).  The change is written to the audit trail in lower case.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $set.xfer.access
$catalog $SETXFERACC

$include keys.h
$include int$keys.h
$include parser.h
$include err.h
$include header.h

   prompt ''
   @system.return.code = -ER$ARGS

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

*  Solo's one account is always sduser (ruling 29); an internal session (the installer's) has another @logname, so the name is not read.
   acc.name = 'sduser'

   parser = "!PARSER"
   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)   ;* the verb
   word.1 = '' ; word.2 = ''
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if token.type # PARSER$END then
      word.1 = token
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
      if token.type # PARSER$END then word.2 = token      ;* a second word is always the syntax message
   end

   openpath @sdsys:@ds:'accounts' to acc.f else
      @system.return.code = -ER$FAILED
      stop sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
   end

   if word.1 = '' then
*     No argument: say where the switch stands, change nothing.
      read acc.rec from acc.f, acc.name else acc.rec = ''
      close acc.f
      xf.now = 'no'
      if upcase(trim(acc.rec<ACC$XFER>)) = 'YES' then xf.now = 'yes'
      @system.return.code = 0
      crt sysmsg(15074, acc.name, xf.now)  ;* Account %1 may move files over its ssh login (receive / send): %2
      stop
   end

*  One action: ON or OFF, and nothing after.
   xf.ok = @true ; xf.want = @false
   begin case
      case upcase(word.1) = 'ON'  ; xf.want = @true
      case upcase(word.1) = 'OFF' ; xf.want = @false
      case 1 ; xf.ok = @false
   end case
   if not(xf.ok) or word.2 # '' then
      close acc.f
      crt sysmsg(15949)  ;* Syntax: set.xfer.access   or   set.xfer.access on|off
      stop
   end

   readu acc.rec from acc.f, acc.name else
      release acc.f, acc.name
      close acc.f
      @system.return.code = -ER$FAILED
      stop sysmsg(10114, acc.name)
   end
   xf.was = (upcase(trim(acc.rec<ACC$XFER>)) = 'YES')
   if xf.was = xf.want then
      release acc.f, acc.name
      close acc.f
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      stop
   end

   acc.new = acc.rec
   if xf.want then acc.new<ACC$XFER> = 'yes' else acc.new<ACC$XFER> = 'no'
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      close acc.f
      @system.return.code = -ER$FAILED
      stop sysmsg(10114, acc.name)
   end
   release acc.f, acc.name
   close acc.f

   @system.return.code = 0
   xf.now = 'no'
   if upcase(trim(acc.new<ACC$XFER>)) = 'YES' then xf.now = 'yes'
   void kernel(K$AUDIT, 'set.xfer.access ' : downcase(word.1) : ' account=' : acc.name)
   crt sysmsg(15074, acc.name, xf.now)  ;* Account %1 may move files over its ssh login (receive / send): %2
   stop

end

* END-CODE
