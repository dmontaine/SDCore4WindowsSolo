               gosub check.file
               if err then return

               id.len = oconv(cmnd[3,2], 'ISL')
               id = cmnd[5,id.len]

               gosub check.voc.edit   ;* 18 Oct 26 dm, Solo carry A: this program is $internal, so the C test does not ask; check.voc.edit does
               if err then return

               write cmnd[5 + id.len, 99999999] to files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Write record, retaiining lock
               * In:  fileno (short integer)
               *      id_len (short integer)
               *      id
               *      data

vb.writeu:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id.len = oconv(cmnd[3,2], 'ISL')
               id = cmnd[5,id.len]

               gosub check.voc.edit   ;* 18 Oct 26 dm, Solo carry A
               if err then return

               writeu cmnd[5 + id.len, 99999999] to files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Delete record
               * In:  fileno (short integer)
               *      id

vb.delete:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id = cmnd[3,99]

               gosub check.voc.edit   ;* 18 Oct 26 dm, Solo carry A
               if err then return

               delete files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Delete record, retaining lock
               * In:  fileno (short integer)
               *      id

vb.deleteu:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               id = cmnd[3,99]

               gosub check.voc.edit   ;* 18 Oct 26 dm, Solo carry A
               if err then return

               deleteu files(fno), id
               on error server.error = SV$ON.ERROR

               return

               * ======================================================================
               * Call catalogued subroutine
               * In:  subr name len (short integer)
               *      subr name (rounded to 2 byte boundary)
               *      arg count (short integer)
               *      arg len (long integer)
               *      arg data (rounded to 2 byte boundary)
               *
               * Out: arg no (short integer)   Always in ascending arg no order
               *      arg len (long integer)
               *      arg data (rounded to 2 byte boundary)

vb.call:
               name.len = oconv(cmnd[1,2], 'ISL')
               * 18 Oct 26 Windows port - from Linux 1298f82 (12 Oct 26): openQM item 241: the lower of 128 and MAXIDLEN (63 unless raised), as in op_jumps.c.  A client
               * (sdclilib.c, sdclient) cannot read MAXIDLEN and keeps 63.
               max.call.len = config('MAXIDLEN')
               if max.call.len > 128 then max.call.len = 128
               if max.call.len < MAX.CALL.NAME.LEN then max.call.len = MAX.CALL.NAME.LEN
               if name.len < 1 or name.len > max.call.len then
                  abort.message = sysmsg(5263) ;* Invalid call name
                  server.error = SV$ON.ERROR
                  return
               end

               subr.name = cmnd[3,name.len]
               pos = 3 + name.len + bitand(name.len, 1)

               arg.count = oconv(cmnd[pos,2], 'ISL')
               pos += 2

               * Are we allowed to run this program?

               obj.flags = load.object(subr.name)
               if subr.name[1,1] = '$' or config("SDCLIENT") = 2 or kernel(K$SDNET, -1) then
                  if not(bitand(obj.flags, HDR.SDCALL.ALLOWED)) then
                     abort.message = sysmsg(5264, subr.name) ;* %1 cannot be called from a SDClient session
                     server.error = SV$ON.ERROR
                     return     ;* 18 Oct 26 RELEASE_1.1 142 (Linux 400500c): it was refused in the reply but still RAN
                  end
               end

               if arg.count then
                  mat args = ''
                  for i = 1 to arg.count
                     arg.len = oconv(cmnd[pos,4], 'ILL')
                     pos += 4
                     args(i) = cmnd[pos,arg.len]
                     pos += arg.len + bitand(arg.len, 1)
                  next i

                  callv @subr.name, arg.count, args

                  * Now return values of changed arguments (if any)

                  for i = 1 to arg.count
                     if changed(args(i)) then
                        response := iconv(i, 'ISL') : iconv(len(args(i)), 'ILL') : args(i)
                        if bitand(len(args(i)), 1) then response := ' '
                     end
                  next i
               end else
                  call @subr.name
               end

               gosub reset.environment

               return

               * ======================================================================
               * Execute command
               * In:  Command string
               * Out: Command output

vb.execute:
               if config("SDCLIENT") # 0  or kernel(K$SDNET, -1) then
                  abort.message = sysmsg(5265) ;* Command execution is disabled
                  server.error = SV$ON.ERROR
                  return
               end

               execute cmnd capturing response
               st = @system.return.code
               return to return.status.set

               * ======================================================================
               * Response to input
               * In:  Command string
               * Should never happen as client end should detect this

vb.respond:
               server.error = SV$ERROR
               error.msg = sysmsg(5266) ;* Response to prompt sent when no prompt outstanding
               return

               * ======================================================================
               * End command
               * Should never happen as client end should detect this

vb.endcommand:
               server.error = SV$ERROR
               error.msg = sysmsg(5267) ;* End command request sent when no prompt outstanding
               return

               * ======================================================================
               * Network login, request 24 - RETIRED.  docs/SCRAM_AUTH.md phase 5.
               *
               * THE CLEARTEXT LOGIN IS GONE AND THERE IS NO FALLBACK.  This
               * handler read a length-prefixed user name and password out of
               * the packet body and passed them to !CRED_VERIFY.  The password
               * crossed the wire in clear, which is the whole reason SCRAM was
               * written; requests 47 and 48 replace it and a client that still
               * sends 24 is refused rather than quietly served a weaker path.
               *
               * IT REFUSES HERE RATHER THAN BEING DROPPED FROM THE GATE ABOVE.
               * Taking 24 out of the "may be sent before authentication" test
               * would answer an old client with 5270 "Not logged in", which is
               * true and useless - it reads as a client bug rather than as a
               * protocol that moved.  One message naming the cause is worth
               * the three lines it costs, and an old client is precisely the
               * caller that will be reading this reply.
               *
               * THE BODY IS NOT PARSED.  It still carries a password, so
               * nothing here reads it, copies it or lets it reach a variable.
               *
               * The connection is dropped, as it was for a failed login.

vb.login:
               abort.message = sysmsg(5275) ;* Request no longer supported...
               server.error = SV$ON.ERROR
               done = @true

               return

               * ======================================================================
               * Login user for SDLocal connection

vb.local.login:
* 25 Sep 26 SD Core Solo - SDConnectLocal IS DISABLED (owner, 25 Sep 2026:
*   "disable sdconnectlocal, they can login with sdconnect instead").  Ruling
*   21 makes every session prove the account password; this request carries
*   none and the client libraries stay unchanged (ruling 18), so it cannot be
*   made to ask.  Refused the way retired request 24 is, with one message
*   naming what to use instead, audited, and the connection ends.  Its old
*   body, which took the caller's identity from the process that started
*   sd.exe, is deleted (SOLO 3 step 5).
               abort.message = sysmsg(12021) ;* SDConnectLocal is not available... use SDConnect
               server.error = SV$ON.ERROR
               void kernel(K$AUDIT, 'api refused request=25 SDConnectLocal - disabled in SD Core Solo')
               done = @true
               return

               * ======================================================================
               * SCRAM-SHA-256 login, client-first.  docs/SCRAM_AUTH.md, phase 3.
               *
               * In:   n,,n=<user>,r=<client nonce>
               * Out:  r=<combined nonce>,s=<salt>,i=<iterations>
               *
               * NO PASSWORD CROSSES THE WIRE IN EITHER DIRECTION, which is the
               * whole point of replacing request 24.  The server publishes the
               * salt and the cost, the client answers a nonce, and a capture of
               * both packets yields an offline guess bounded by the iteration
               * count and nothing else.
               *
               * THE BODY IS THE SCRAM MESSAGE AND NOTHING ELSE.  vb.login's body
               * is length-prefixed fields each padded to a two byte multiple;
               * this one is not, because the packet is already length delimited.
               * scram.trim.body drops trailing NULs anyway - see there for why.
               *
               * THE SERVER DOES NOT RUN PBKDF2 HERE.  It holds StoredKey, so
               * the 600,000 iterations are spent once, in MODIFY.PASSWORD.  Login
               * costs two HMACs and a hash, which is what makes it safe to do
               * this work before the client has proved anything.

vb.scram.first:
               gosub scram.trim.body

               * A fresh exchange on a session that has already authenticated is
               * a client bug or an attempt to change identity part way through.
               * vb.login needed no such guard because it was a single message
               * that set logged.in and nothing followed it.
               if logged.in then
                  scram.refuse.reason = 'sequence error - already authenticated'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               scram.stage = 0        ;* a restart abandons any exchange in flight

* 02 Oct 26 SD Core Solo - SOLO 25, THE LOGIN HOLD: no new API session while
*   BACKUP.ACCOUNT or RESTORE.ACCOUNT runs (owner, 1 Oct 2026; LOGIN refuses
*   the same way, and so do the other three products here).  Before any
*   credential is looked at, so a refused client learns nothing else.
*   vb.local.login needs no copy: it refuses every request in Solo.
               call !acc_hold('TEST', hold.info, hold.err)
               if hold.err # '' then
                  scram.refuse.reason = 'a backup or restore is running'
                  abort.message = sysmsg(hold.err<1,1>, hold.err<1,2>, hold.err<1,3>)
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

* 18 Oct 26 Windows port - from Linux 3b43525 (15 Oct 26): - INHIBIT.LOGIN (QM4 gaps Q-8), the same refusal, in the same place.
               call !login_inhibit('TEST', hold.info, hold.err)
               if hold.err # '' then
                  scram.refuse.reason = 'logins are inhibited (inhibit.login)'
                  abort.message = sysmsg(hold.err<1,1>, hold.err<1,2>, hold.err<1,3>)
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

* 15 Sep 26 Windows port - S.19/RELEASE_1.1 41: THE GS2 HEADER FOLLOWS THE
*   TRANSPORT; THE CLIENT DOES NOT CHOOSE IT.  Every socket connection is TLS
*   (gplsrc/sd_tlssrv.c) and must bind the login to it with 'p=tls-exporter,,'
*   (RFC 9266).  A session with no TLS - a local pipe - has nothing to bind to
*   and must say 'n,,'.  'y,,' (the downgrade signal) is refused everywhere.
*   A client that offered 'n,,' over TLS would be a downgrade, so it is a
*   malformed message here, not a weaker login.
               scram.cbind = SDEXT('', @FALSE, SD_TLS_CBIND)
               if scram.cbind = '' then scram.gs2 = 'n,,' else scram.gs2 = 'p=tls-exporter,,'
               if cmnd[1,len(scram.gs2)] # scram.gs2 then goto scram.bad.message

               scram.cfirst.bare = cmnd[len(scram.gs2)+1,99999999]

               * Exactly two attributes.  RFC 5802 section 5 requires the server
               * to FAIL on an m= mandatory extension rather than ignore it, and
               * counting the commas is what makes that automatic: anything
               * extra, in any position, lands here.
               *
               * It also settles the nonce.  A client nonce containing a comma
               * would split into three fields and be refused now, rather than
               * mismatching later for reasons nobody could see.
               if count(scram.cfirst.bare, ',') # 1 then goto scram.bad.message

               scram.attr = field(scram.cfirst.bare, ',', 1)
               if scram.attr[1,2] # 'n=' then goto scram.bad.message
               username = scram.attr[3,99999999]

               * TAKEN HERE, BEFORE ANY CHECK, so that every refusal below has a
               * name to record - including the ones that reject the name
               * itself, which are the interesting ones.  Sanitised because at
               * this point it is still whatever the client sent.
               gosub scram.clean.name

               scram.attr = field(scram.cfirst.bare, ',', 2)
               if scram.attr[1,2] # 'r=' then goto scram.bad.message
               scram.cnonce = scram.attr[3,99999999]
               if scram.cnonce = '' then goto scram.bad.message

               * NO =2C / =3D UNESCAPING, and none is needed: valid_os_name
               * allows letters, digits, dot, underscore and hyphen only, so a
               * name that would have required escaping cannot be a user here.
               * Refusing it is therefore the same answer as decoding it.
               if username = '' or username[1,1] = '$' then
                  scram.refuse.reason = 'unusable name'
                  goto scram.bad.cred
               end
               if not(valid_os_name(username)) then
                  scram.refuse.reason = 'name rejected by valid_os_name'
                  goto scram.bad.cred
               end

* 25 Sep 26 SD Core Solo - ruling 18: THE ADMINISTRATOR PASSWORD IS NOT AN API
*   LOGIN.  $cred is keyed by upcase(name), and it also holds $ADMIN and
*   $GLOBAL (solo_password), so a client naming itself "$admin" would be
*   checked against the administrator password.  No account name can start
*   with $ (solo_account: a letter first), so every such name is refused here,
*   before the record is read, with the same indistinct answer as a guess.
               if username[1,1] = '$' then
                  scram.refuse.reason = 'reserved name'
                  goto scram.bad.cred
               end

               openpath @sdsys:@ds:'$cred' to scram.cred.f else
                  scram.refuse.reason = 'cannot open $cred'
                  abort.message = sysmsg(5274) ;* Authentication service unavailable
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

* 25 Sep 26 SD Core Solo - RULING 19: ONE LOGIN NAME, TWO PASSWORDS.  The
*   account's own record (the user's API password) and $GLOBAL (the master
*   server's) are both read here; !CRED_SET gives them the same salt and
*   iteration count, so the server-first below is right for either, and
*   vb.scram.final checks the proof against the user's key and then the
*   global one.  The global key is used only when its salt and count really
*   match - a record that disagrees could never verify, and saying so beats
*   refusing the master for a reason nobody can see.  With no API password
*   set, the master may still log in under the name, but only the name of an
*   account in the register (the one Solo account, ruling 10).
               scram.gstored = ''
               scram.gserver = ''
               have.user = @false
               read scram.cred from scram.cred.f, upcase(username) then
                  have.user = @true
               end else
                  scram.cred = ''
               end
               have.global = @false
               read scram.gcred from scram.cred.f, '$GLOBAL' then
                  if scram.gcred<CRED$VERSION> = SCRAM$CRED.VERSION then have.global = @true
               end else
                  scram.gcred = ''
               end
               close scram.cred.f

               if have.user then
                  * A version 1 record holds an Argon2 verifier and no StoredKey.
                  * It cannot drive a SCRAM exchange and cannot be converted -
                  * the plaintext was never stored, by design - so the account
                  * has to set its password again.  !CRED_VERIFY refuses it too.
                  if scram.cred<CRED$VERSION> # SCRAM$CRED.VERSION then
                     scram.cred = ''
                     scram.gcred = ''
                     scram.refuse.reason = 'credential is version 1 - run set.password'
                     goto scram.bad.cred
                  end
                  scram.salt = scram.cred<CRED$SALT>
                  scram.iter = scram.cred<CRED$ITER>
                  scram.storedkey = scram.cred<CRED$STOREDKEY>
                  scram.serverkey = scram.cred<CRED$SERVERKEY>
                  if scram.storedkey = '' or scram.serverkey = '' then
                     scram.storedkey = ''
                     scram.serverkey = ''
                  end
               end else
                  in.register = @false
                  if have.global then
                     openpath @sdsys:@ds:'accounts' to scram.acc.f then
                        read scram.acc.rec from scram.acc.f, downcase(username) then in.register = @true
                        close scram.acc.f
                     end
                  end
                  if not(in.register) then
                     scram.gcred = ''
                     scram.refuse.reason = 'no credential'
                     goto scram.bad.cred      ;* no credential - fail closed
                  end
                  scram.salt = scram.gcred<CRED$SALT>
                  scram.iter = scram.gcred<CRED$ITER>
                  scram.storedkey = ''
                  scram.serverkey = ''
               end
               if have.global then
                  if scram.gcred<CRED$SALT> = scram.salt and scram.gcred<CRED$ITER> = scram.iter then
                     scram.gstored = scram.gcred<CRED$STOREDKEY>
                     scram.gserver = scram.gcred<CRED$SERVERKEY>
                     if scram.gstored = '' or scram.gserver = '' then
                        scram.gstored = ''
                        scram.gserver = ''
                     end
                  end else
                     void kernel(K$AUDIT, 'api note user=' : scram.audit.name : " - $GLOBAL does not share this account's salt, so the global password cannot log in under this name (ruling 19)")     ;* 11 Nov 26: was 'account''s' - SD BASIC has no '' escape
                  end
               end
               scram.cred = ''
               scram.gcred = ''

               if scram.salt = '' or scram.iter = '' then
                  scram.refuse.reason = 'credential incomplete'
                  goto scram.bad.cred
               end
               if scram.storedkey = '' and scram.gstored = '' then
                  scram.refuse.reason = 'credential incomplete'
                  goto scram.bad.cred
               end

               * 18 RANDOM BYTES, AND THE 18 IS NOT ARBITRARY.  It is a multiple
               * of three, so base64 encodes it with no '=' padding, and every
               * character base64 emits is inside RFC 5802's printable set -
               * which excludes the comma this message is parsed on and the
               * space that would end it.
               scram.snonce = SDEXT('18', @TRUE, SD_RANDBYTES)
               if scram.snonce = '' then goto scram.crypto.failed

               scram.nonce = scram.cnonce : scram.snonce

               * KEPT VERBATIM, NOT REBUILT.  server-first goes into AuthMessage
               * byte for byte, so storing the string that was actually sent
               * removes any chance of the two differing - which would fail the
               * signature check with nothing to show for it.
               scram.sfirst = 'r=' : scram.nonce : ',s=' : scram.salt : ',i=' : scram.iter

               scram.user = username
               scram.stage = 1
               response = scram.sfirst

               return

               * ======================================================================
               * SCRAM-SHA-256 login, client-final.  docs/SCRAM_AUTH.md, phase 3.
               *
               * In:   c=biws,r=<combined nonce>,p=<ClientProof>
               * Out:  v=<ServerSignature>
               *
               * THE SERVER NEVER HOLDS ClientKey.  It recovers a candidate from
               * the proof and checks its SHA-256 against StoredKey, so a stolen
               * $cred still cannot authenticate as the client - forming a proof
               * needs the preimage.  It CAN impersonate the server, which is
               * why the $cred ACL matters exactly as much as it did before.

vb.scram.final:
               gosub scram.trim.body

               if logged.in then
                  scram.refuse.reason = 'sequence error - already authenticated'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               * A client-final with no client-first before it has no nonce to
               * answer and no AuthMessage to sign.  Refusing here is the point:
               * running the comparison against empty values is the shape of bug
               * that turns a signature check into a formality.
               if scram.stage # 1 then
                  scram.refuse.reason = 'sequence error - no client-first'
                  abort.message = sysmsg(5273) ;* Authentication sequence error
                  server.error = SV$ON.ERROR
                  goto exit.vb.scram.fail
               end

               * ONE ATTEMPT PER CLIENT-FIRST.  Cleared before the proof is
               * examined, so a client cannot sit on one server-first and grind
               * proofs against it - each guess costs a fresh round trip and the
               * three second sleep below.
