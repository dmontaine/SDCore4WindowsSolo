               * also the only brake besides the sleep: there is still no
               * lockout, so making each guess pay for a new connection is worth
               * the little it buys.
               scram.stage = 0
               scram.storedkey = ''
               scram.serverkey = ''
               done = @true

               return

               * ----------------------------------------------------------------------
               * Drop trailing NULs from the request body.
               *
               * THE MESSAGE NEEDS NO PADDING AND MUST NOT BE GIVEN ANY - the
               * packet carries its own length.  But vb.login's body pads every
               * field to a two byte multiple with a NUL, and a client written
               * from that precedent would put one inside the base64, where it
               * would surface as "authentication failed" with nothing to show
               * which byte was at fault.  NUL is not valid anywhere in a SCRAM
               * message, so dropping it here can only remove padding.

scram.trim.body:
               loop
               while cmnd # '' and cmnd[len(cmnd),1] = char(0)
                  cmnd = cmnd[1,len(cmnd)-1]
               repeat

               return

               * ----------------------------------------------------------------------
               * The presented user name, made safe to put in the audit trail.
               * Reads username, writes scram.audit.name.
               *
               * WHY IT HAS TO BE SANITISED: audit_message() (k_error.c) writes
               * the text VERBATIM and ends the record with a newline, so a name
               * carrying one would FORGE AN AUDIT LINE - and this runs on the
               * paths where the name has NOT passed valid_os_name, which is the
               * whole point of recording it.  The name is still whatever the
               * client sent, and a hostile client is not bound by the 32
               * character cap our own sdclilib applies.
               *
               * THE PERMITTED SET IS valid_os_name's OWN, so a name that would
               * have been accepted appears unchanged and anything else is
               * visibly marked with ?.  Reading the trail therefore shows what
               * was tried without the trail being able to lie about it.

scram.clean.name:
               * Assigned here rather than kept in the state block above: it is a
               * constant, not per-session state, and VALID_OS_NAME sets its own
               * copy the same way.  The two must not drift - if that one gains
               * a character, so does this.
               scram.cn.chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-'
               scram.cn.raw = username
               scram.cn.trunc = @false
               if len(scram.cn.raw) > MAX.USERNAME.LEN then
                  scram.cn.raw = scram.cn.raw[1, MAX.USERNAME.LEN]
                  scram.cn.trunc = @true
               end

               * The same convert() idiom VALID_OS_NAME uses, inverted: the
               * first call collects the characters that are NOT allowed, the
               * second maps each of them to ?.  Duplicates in the first result
               * are harmless - convert maps positionally and both map to ?.
               scram.cn.bad = convert(scram.cn.chars, '', scram.cn.raw)
               if scram.cn.bad # '' then
                  scram.cn.raw = convert(scram.cn.bad, str('?', len(scram.cn.bad)), scram.cn.raw)
               end

               scram.audit.name = scram.cn.raw
               if scram.audit.name = '' then scram.audit.name = '(empty)'
               if scram.cn.trunc then scram.audit.name := '...'
               return

               * ======================================================================
               * Select index
               * In:  file no  (short int)
               *      list no  (short int)
               *      index name len (short int)
               *      index name (padded to 2 byte interval)
               *      index value len (short int)
               *      index value (padded to 2 byte interval)

vb.selectindex:
               fno = oconv(cmnd[1,2], 'ISL')
               gosub check.file
               if err then return

               listno = oconv(cmnd[3,2], 'ISL')
               gosub check.list
               if err then return

               * Extract index name

               pos = 5
               n = oconv(cmnd[pos,2], 'ISL')
               pos += 2
               index.name = cmnd[pos, n]
               pos += n + bitand(n, 1)

               * Extract index value

               n = oconv(cmnd[pos,2], 'ISL')
               pos += 2
               index.value = cmnd[pos, n]

               selectindex index.name, index.value from files(fno) to listno

               return

