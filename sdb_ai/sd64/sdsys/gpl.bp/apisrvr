* 19 Aug 26 Windows port - SCRAM exchange state.  docs/SCRAM_AUTH.md.
*
* THIS IS ALL THE PER-SESSION STATE THE EXCHANGE NEEDS, and it is ordinary
* program variables because APISRVR is one process per connection running one
* loop: a variable set while handling request 47 is still set when 48 arrives,
* and no two connections share it.  Nothing is written to disk and nothing is
* keyed by session id, so there is no cross-session leak to reason about.
*
* THEY ARE INITIALISED HERE, OUTSIDE THE FIRST-TIME BLOCK, ON PURPOSE.  An
* unassigned variable would make "did request 47 happen" depend on a variable
* that has never been written, and scram.stage is the only thing standing
* between a client-final and a signature check run against empty values.
scram.stage = 0        ;* 0 = no exchange in progress, 1 = client-first accepted
scram.user = ''        ;* User name from client-first, once screened
scram.cfirst.bare = '' ;* client-first-bare, the GS2 header stripped
scram.sfirst = ''      ;* server-first, exactly as it went out
scram.nonce = ''       ;* Combined nonce, client's then ours
scram.storedkey = ''   ;* From $cred, base64
scram.serverkey = ''   ;* From $cred, base64
scram.gstored = ''     ;* $GLOBAL's StoredKey, when it shares the salt (ruling 19)
scram.gserver = ''     ;* $GLOBAL's ServerKey, likewise
scram.via = ''         ;* 'user' or 'global': which record the proof matched
* THE AUDIT TRAIL'S TWO VARIABLES.  scram.refuse.reason is the whole mechanism:
* '' means "this exchange has not been refused", and any other value is written
* once at exit.vb.scram.fail.  Keeping it here with the rest of the state is
* what makes a refusal impossible to leave unlogged - every path out of both
* handlers goes through that one exit.
scram.fail.delay = 0    ;* A credential failure: sleep PWDELAY s (3 by default) AFTER the audit record is written (05 Oct 26; named as Linux's)
scram.audit.name = ''   ;* Name as PRESENTED, sanitised - see scram.clean.name
scram.refuse.reason = '';* Why this exchange was refused; '' = not refused
* (scram.handoff, RELEASE_1.1 55's flag, is gone: SD Core Solo has no handover.)

loop
   unload.object               ;* Unload inactive object code

   * Fetch new command

   cmnd = readpkt()
   if cmnd = '' then
      logmsg sysmsg(5271) ;* Connection to client lost
      goto abort.vbsrvr
   end

   if logging then
      s = oconv(cmnd, 'MX0C')
      writeseq '> ' : s[1,4] : ' ' : s[5,1000] to log.f else null
   end

   action = oconv(cmnd[1,2], 'ISL')

   cmnd = cmnd[3,99999999]          ;* Strip off action code
   response = ''
   server.error = SV$OK           ;* Assume success

   if not(logged.in) then
      * 19 Aug 26 Windows port - 47 and 48 join 24 and 25 as the requests a
      * session may issue before it has authenticated.  They are the two halves
      * of one SCRAM exchange, so both have to be admitted here; 48 refuses
      * itself if 47 did not come first, which is a check this gate cannot make.
      * 20 Aug 26 Windows port - 24 STAYS IN THIS LIST THOUGH IT IS RETIRED, so
      * that vb.login can answer with 5275 and name the reason.  Dropping it
      * here would answer an old client with 5270 "Not logged in" instead.
      if action # 24 and action # 25 and action # 47 and action # 48 then
         abort.message = sysmsg(5270) ;* Not logged in
         goto connection.failed
      end
   end

   cproc.date = date()
   cproc.time = time()

* 12 Nov 26 SD Core Solo - SOLO 56 group 7, as Linux Solo (f084a3f, b1d823f): requests 68 to 71 change files on the server's side (WRITE ... CREATING.SEQKEY,
*   and the file administration of group 8), so only a session that signed in with the GLOBAL password may send them - the master server administering
*   this Solo.  Asked of the kernel at every request (K$GLOBAL.SESSION is set at login, vb.scram.final).  The refusal has SD Core's shape: an ON ERROR
*   reply with its own text and one audit line.
   if action >= 68 and action <= 71 then
      if not(kernel(K$GLOBAL.SESSION, -1)) then
         void kernel(K$AUDIT, 'api refused request=' : action : ' global=off user=' : @logname)  ;* @logname, not logname: a plain variable does not survive an abort
         server.error = SV$ON.ERROR
         abort.message = sysmsg(15964, action) ;* This session cannot administer files here: sign in with the global password (request %1)
         st = status()
         goto return.status.set
      end
   end

   on action + 1 gosub vb.illegal.action,
   vb.quit,           ;*   1   Quit
   vb.geterror,       ;*   2   Get extended error text
   vb.account,        ;*   3   Set account
   vb.open,           ;*   4   Open file
   vb.close,          ;*   5   Close file
   vb.read,           ;*   6   Read record (READ)
   vb.readl,          ;*   7   Read record (READL)
   vb.readlw,         ;*   8   Read record (READL, waiting)
   vb.readu,          ;*   9   Read record (READU)
   vb.readuw,         ;*  10   Read record (READU, waiting)
   vb.select,         ;*  11   Select file
   vb.readnext,       ;*  12   Read next id from select list
   vb.clearselect,    ;*  13   Clear select list
   vb.readlist,       ;*  14   Read select list
   vb.release,        ;*  15   Release lock
   vb.write,          ;*  16   Write record
   vb.writeu,         ;*  17   Write record, retaining lock
   vb.delete,         ;*  18   Delete record
   vb.deleteu,        ;*  19   Delete record, retaining lock
   vb.call,           ;*  20   Call catalogued subroutine
   vb.execute,        ;*  21   Execute command
   vb.respond,        ;*  22   Response to input
   vb.endcommand,     ;*  23   End command
   vb.login,          ;*  24   Network login - RETIRED, always refused
   vb.local.login,    ;*  25   SDLocal login
   vb.selectindex,    ;*  26   Select index
   vb.illegal.action, ;*  27   Enter licensed package - not supported
   vb.illegal.action, ;*  28   Exit licensed package  - not supported
   vb.open.sdnet,     ;*  29   Open SDNet file
   vb.lock.record,    ;*  30   Lock a record
   vb.clearfile,      ;*  31   Clearfile
   vb.filelock,       ;*  32   Get file lock
   vb.fileunlock,     ;*  33   Release file lock
   vb.recordlocked,   ;*  34   Test lock
   vb.indices1,       ;*  35   Fetch information about indices
   vb.indices2,       ;*  36   Fetch information about an index
   vb.selectlist,     ;*  37   Select file and return list
   vb.selectindexv,   ;*  38   Select index, returning indexed values
   vb.selectindexk,   ;*  39   Select index, returning keys for value
   vb.fileinfo,       ;*  40   Perform FILEINFO() action
   vb.readv,          ;*  41   READV and variants
   vb.setleft,        ;*  42   Set index at extreme left
   vb.setright,       ;*  43   Set index at extreme right
   vb.selectleft,     ;*  44   Scan index to left
   vb.selectright,    ;*  45   Scan index to right
   vb.mark.mapping,   ;*  46   Enable/disable mark mapping
   vb.scram.first,    ;*  47   SCRAM client-first
   vb.scram.final,    ;*  48   SCRAM client-final
   vb.revision,       ;*  49   Server revision (QMRevision), as Core.  Until 11 Nov 26 (SOLO 55) this was the ssh key request, now 72
   vb.getvar,         ;*  50   Get a value of the server's session (QMGetVar)
   vb.system,         ;*  51   SYSTEM() (QMSystem)
   vb.trans,          ;*  52   TRANS() (QMTrans)
   vb.rtrans,         ;*  53   RTRANS() (QMRTrans)
   vb.txn,            ;*  54   Transaction start, commit, abort or non-durable commit (QMTxn)
   vb.evaluate,       ;*  55   Evaluate a dictionary expression on a record (QMEvaluate)
   vb.evalconv,       ;*  56   The same, with a conversion
   vb.iconv,          ;*  57   ICONV (QMIconv)
   vb.oconv,          ;*  58   OCONV (QMOconv)
   vb.iconvs,         ;*  59   ICONVS (QMIconvs)
   vb.oconvs,         ;*  60   OCONVS (QMOconvs)
   vb.openseq,        ;*  61   OPENSEQ (QMOpenSeq)
   vb.readseq,        ;*  62   READSEQ
   vb.readblk,        ;*  63   READBLK
   vb.writeseq,       ;*  64   WRITESEQ
   vb.writeblk,       ;*  65   WRITEBLK
   vb.seek,           ;*  66   SEEK
   vb.weofseq,        ;*  67   WEOFSEQ
   vb.writeseqkey,    ;*  68   WRITE ... CREATING.SEQKEY (global session only, the gate above)
   vb.writeuseqkey,   ;*  69   WRITEU ... CREATING.SEQKEY (global session only)
   vb.fileadmin,      ;*  70   A verb run on the server for the session: analyse, configure, index, create, delete (S.73 item 3) - global session only
   vb.fcontrol,       ;*  71   FCONTROL(file, key, value) (S.73 item 3) - global session only
   vb.sshkey,         ;*  72   Manage the SD Core server's ssh keys (global session only); Core reserves 72 for it
   vb.illegal.action

   st = status()
return.status.set: ;* Return to here if ST already set

   if server.error = SV$ON.ERROR then response = @abort.message

   * 18 Oct 26 Windows port - from Linux 9f067b8 (11 Oct 26): - a record read from a data collection file is a collection; the client is sent its JSON
   * text, the compact form the file holds
   jt = jtype(response)
   if jt = 'collection' or jt = 'array' then response = jbuild(response)

   if logging then
      s = oconv(iconv(server.error, 'ISL'):iconv(st, 'ILL'):response, 'MX0C')
      writeseq '< ' : s[1,4] : ' ' : s[5,8] : ' ' : s[13,1000] to log.f else null
   end

* 25 Sep 26 SD Core Solo - THE K$HANDOFF PREPARE AND COMMIT THAT STOOD AROUND
*   THIS writepkt ARE GONE: a successful SCRAM login sets logged.in and this
*   same process serves the session (vb.scram.final).  RELEASE_1.1 57's race -
*   a client byte read off the net before the cutover - cannot arise, because
*   nothing cuts over.  HISTORY.md keeps RELEASE_1.1 55 and 57.
   writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):response
until done
repeat

abort.vbsrvr:
return to abort.vbsrvr

connection.failed:
server.error = SV$ON.ERROR
st = status()
writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):@abort.message
goto abort.vbsrvr

