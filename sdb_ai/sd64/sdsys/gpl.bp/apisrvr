scram.bad.message:
               if scram.refuse.reason = '' then scram.refuse.reason = 'malformed authentication message'
               abort.message = sysmsg(5272) ;* Invalid authentication message
               server.error = SV$ON.ERROR
               goto exit.vb.scram.fail

scram.crypto.failed:
               if scram.refuse.reason = '' then scram.refuse.reason = 'authentication service failed'
               * A primitive that fails is a fault in this server, not a wrong
               * password, and saying so costs nothing: it tells an attacker
               * only that SDEXT is broken, which no credential depends on.
               abort.message = sysmsg(5274) ;* Authentication service unavailable
               server.error = SV$ON.ERROR
               goto exit.vb.scram.fail

scram.bad.cred:
               * ONE MESSAGE AND ONE DELAY FOR EVERY CREDENTIAL FAILURE, as
               * vb.login has.  Unknown account, version 1 record and wrong
               * password read identically in the reply.
               *
               * THEY ARE NOT IDENTICAL IN THE ROUND TRIP, and that is a known
               * gap rather than an oversight: an account with no usable
               * credential fails at 47, a wrong password at 48, so the two are
               * distinguishable by which request was refused.  RFC 5802's
               * answer is a dummy salt derived from a server-held secret, so an
               * unknown account receives a plausible server-first and fails at
               * 48 like everyone else.  That needs a secret this program can
               * read but not write - docs/SCRAM_AUTH.md, "Still open".
               if scram.refuse.reason = '' then scram.refuse.reason = 'credential'
               abort.message = sysmsg(5017) ;* Invalid username or password
               server.error = SV$ON.ERROR
               * 05 Oct 26 - THE DELAY MOVED TO exit.vb.scram.fail, AFTER THE AUDIT WRITE.
               * It used to be here, so a client that dropped inside the three seconds
               * could end this process before the record was written: Linux lost it 5
               * of 5 times (its S.60); measured here it did NOT happen (10 of 10
               * audited, probe-failaudit.ps1, installed Solo 4 Oct), so this is the
               * same behaviour with the order that cannot lose the record.  The reply
               * and the delay are unchanged for the caller.
               * 18 Oct 26 Windows port - from Linux 1298f82 (12 Oct 26): the length of the
               * wait is the PWDELAY configuration parameter (openQM item 106), seconds, 3
               * unless sd.conf says otherwise (openQM's own default is 5); 0 means no wait.
               * The variable (scram.fail.delay, was the flag scram.delay here) holds the
               * seconds, 0 = none, and is tested at the exit label as Linux's apisrvr does.
               scram.fail.delay = config('PWDELAY')
               goto exit.vb.scram.fail

exit.vb.scram.fail:
               * THE ONE PLACE A REFUSED LOGIN IS RECORDED, and the reason it is
               * here rather than at each refusal: every path out of both
               * handlers passes through this label, so a refusal added later is
               * audited whether or not its author thinks about the trail.  Same
               * argument as LOGIN's terminate.connection (section 7 step 4).
               *
               * THE CLIENT IS TOLD NOTHING NEW.  abort.message is already set
               * by the label that sent us here, and every credential failure
               * still answers 5017 after the same three second sleep.  The
               * trail gets the truth; the caller gets what it always got.
               *
               * THE COST, ACCEPTED DELIBERATELY: a stranger can now make this
               * server write an audit record, one per connection and never
               * faster than the sleep above allows.  An unlogged authentication
               * failure is the worse of the two, and win32_audit_rotate()
               * exists for the file.
               if scram.refuse.reason # '' then
                  * A client-final with no client-first never reached the name,
                  * so there is nothing to report rather than an empty field.
                  if scram.audit.name = '' then scram.audit.name = '(none)'
                  void kernel(K$AUDIT, 'api refused user=' : scram.audit.name : ' reason=' : scram.refuse.reason)
                  scram.refuse.reason = ''
               end

               * The failed-login delay, now that the record is safely written.
               if scram.fail.delay > 0 then
                  sleep scram.fail.delay
                  scram.fail.delay = 0
               end

