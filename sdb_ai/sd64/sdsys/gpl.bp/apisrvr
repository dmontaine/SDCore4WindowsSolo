               gosub check.list
               if err then return

               clearselect listno

               return

               * ======================================================================
               * Read select list
               * In:  listno (short integer)

vb.readlist:
               listno = oconv(cmnd[1,2], 'ISL')
               gosub check.list
               if err then return

               readlist response from listno else response = ''

               return

               * ======================================================================
               * Release lock
               * In:  fileno (short integer)
               *      id

vb.release:
               fno = oconv(cmnd[1,2], 'ISL')
               if fno then               ;* 0249
                  gosub check.file
                  if err then return
               end

               id = cmnd[3,99]

               begin case
                  case fno = 0
                     release

