                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5268) ;* Invalid file number
                                                                        return
                                                                     end

                                                                     if not(fileinfo(files(fno), FL$OPEN)) then ;* File not open
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5268) ;* Invalid file number
                                                                        return
                                                                     end

                                                                     err = @false
                                                                     return


                                                                     * ======================================================================
* check.voc.edit  -  may the client change the file files(fno)?  (18 Oct 26 dm, Solo carry A, owner's ruling B)
*   This program is $internal, which the C test (voc_write_refused, global_write_refused) lets through, so a client of the API could write,
*   delete or clear the VOC, or a record of gcat, global.bp.out or solo.policy, with no ADMIN and no global session.  !voc_refusal answers
*   for the file as opened (a Q-pointer is caught) and displays nothing, which is why it is asked and not !voc_guard: this program has no
*   terminal to display on.  The answer is the text of the error the client is sent.  Ask after check.file.
check.voc.edit:
                                                                     err = @true
                                                                     voc.refusal = voc_refusal(files(fno))
                                                                     if voc.refusal then
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(voc.refusal) ;* 12008 the VOC needs ADMIN / 12028 the global files need the global session
                                                                        return
                                                                     end
                                                                     err = @false
                                                                     return


                                                                     * ======================================================================
check.list:
                                                                     err = @true

                                                                     if listno < 0 or listno > 10 then      ;* Invalid list number   0225
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5269) ;* Invalid select list number
                                                                        return
                                                                     end

                                                                     err = @false
                                                                     return
                                                                  end



