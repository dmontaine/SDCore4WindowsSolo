*
* START-DESCRIPTION:
*
*    SET.PASSWORD      ask for the new account password twice and store it
*
* Rulings 18 and 21: the account has a password of its own, asked by every
* session (local, ssh, API, one-shot), set by the installer (solo_password
* ACCOUNT) and changed by this verb.  The owner's choice, 25 Sep 2026: the
* gate is the one every administrator command has - ADMIN must have been
* unlocked in this session (ruling 12, K$ADMINISTRATOR).
*
* It sets the password of the account this session is IN (@who), and only an
* account in the register - never SDSYS, which is nobody's login (ruling 11).
* The record is the account's name in $cred, the one apisrvr's SCRAM reads.
*
* The new password must be printable ASCII (the installer's rule, and what
* solo_password enforces), and must differ from the global password: under
* ruling 19 one login name carries both, the user's checked first, so an
* equal password would land the master server in an ordinary session.
*
* The password is never displayed, stored or logged; the change is audited.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set_password
$catalog $SETPW

$include keys.h
$include int$keys.h
$include err.h

deffun pw_complex(pw) calling '!pw_complex'

   prompt ''
   @system.return.code = -ER$ARGS

   if not(kernel(K$ADMINISTRATOR, -1)) then
      display sysmsg(2001) ;* Command requires administrator privileges
      stop
   end

   acc.name = downcase(@who)
   known = @false
   if acc.name # 'sdsys' then
      openpath @sdsys : @ds : 'accounts' to acc.f then
         read acc.rec from acc.f, acc.name then known = @true
         close acc.f
      end
   end
   if not(known) then
      display sysmsg(12015, @who) ;* %1 cannot have an account password
      stop
   end

   display sysmsg(12009) : ' ' :  ;* New password:
   input pw1 HIDDEN
   display
   display sysmsg(12010) : ' ' :  ;* Confirm the new password:
   input pw2 HIDDEN
   display

   if pw1 = '' or pw1 # pw2 then
      pw1 = '' ; pw2 = ''
      display sysmsg(12011) ;* The passwords do not match - the password is unchanged
      stop
   end
   pw2 = ''

   for i = 1 to len(pw1)
      c = seq(pw1[i,1])
      if c < 33 or c > 126 then
         pw1 = ''
         display sysmsg(12013) ;* Use letters, digits and punctuation only...
         stop
      end
   next i

   if not(pw_complex(pw1)) then
      pw1 = ''
      display sysmsg(10920) ;* A password needs at least 8 characters, with...
      stop
   end

*  Ruling 19.  CRED_VERIFY fails closed on a missing record, so standalone
*  mode (no $GLOBAL) answers @false here and nothing is refused.
   same = @false
   call !CRED_VERIFY('$GLOBAL', pw1, same)
   if same then
      pw1 = ''
      display sysmsg(12014) ;* The account password must differ from the global password
      stop
   end

   stored = @false
   call !CRED_SET(upcase(acc.name), pw1, stored)
   pw1 = ''
   if not(stored) then
      display sysmsg(12016, status()) ;* The password could not be stored (status %1)
      stop
   end

   void kernel(K$AUDIT, 'ACCOUNT PASSWORD SET account=' : acc.name)
   @system.return.code = 0
   display sysmsg(12012) ;* Password changed
end

* END-CODE
