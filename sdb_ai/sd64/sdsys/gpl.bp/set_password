* START-HISTORY:
* 28 Sep 26 SD Core Solo for Windows - ruling 39: SET.PASSWORD [ADMIN|GLOBAL].
*           The account password needs no ADMIN (the current one is asked
*           instead, outside an ADMIN or global session); ADMIN changes the
*           administrator password; a global session changes all three.
*           Messages 12031-12035.
* 26 Sep 26 SD Core Solo - rewrites the DPAPI copy for one-shot commands
*           (!SOLO_STORE_PW, SOLO 15 piece 4); 12022 when it cannot.
* 25 Sep 26 SD Core Solo - SET.API.PASSWORD -> SET.PASSWORD (owner, ruling 21:
*           "since it is now global"): the account password is asked by every
*           session, local, ssh, API and one-shot, not only the API.
* 25 Sep 26 SD Core Solo - runs the password rule (pw_complex, 10920) like
*           every prompt that sets a password (test-pwcomplex-units.ps1);
*           MODIFY.PASSWORD, which carried it before, is retired.
* 25 Sep 26 SD Core Solo - new, SOLO 3 step 3 (docs/SOLO_API.md).
* END-HISTORY
*
* START-DESCRIPTION:
*
*    SET.PASSWORD         the account password
*    SET.PASSWORD ADMIN   the administrator password
*    SET.PASSWORD GLOBAL  the global password (managed mode)
*
* RULING 39, owner 28 Sep 2026: "in managed mode global should always have
* the ability to change all passwords, sduser should always be able to change
* the account password, admin should be able to change the administrator
* password".  So:
*
*    account   anyone in the account.  Without ADMIN (K$ADMINISTRATOR) the
*              CURRENT account password is asked first (owner, same day), so
*              an unattended session cannot be taken over by changing it.
*    ADMIN     K$ADMINISTRATOR - ADMIN unlocked, or a global session.
*    GLOBAL    a global session only (K$GLOBAL.SESSION, 12033), and only
*              where a global password exists: ruling 15 - no verb creates or
*              clears it, so standalone answers 12034.
*
* Before ruling 39 this changed the account password only and needed ADMIN
* (25 Sep 2026); the administrator and global passwords could be set only by
* the installer.
*
* It sets the account password of the account this session is IN (@who),
* and only an account in the register - never SDSYS (ruling 11).  The
* records are the account's name, $ADMIN and $GLOBAL in $cred; !CRED_SET
* keeps a record's own salt on a change, so the account and $GLOBAL still
* share one (ruling 19, which the API's SCRAM needs).
*
* The new password must be printable ASCII and meet pw_complex, and the
* three must all differ where they exist (12014 for the account against the
* global, 12035 otherwise): under ruling 19 one login name carries the account
* and global passwords, the account's checked first, so equal ones would land
* the server in an ordinary session; and the installer has always refused an
* administrator password equal to the global one.
*
* The password is never displayed, stored or logged; the change is audited.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set_password
$catalog $SETPW

$include keys.h
$include int$keys.h
$include err.h

deffun pw_complex(pw) calling '!pw_complex'

   prompt ''
   @system.return.code = -ER$ARGS

   which = upcase(field(trim(@sentence), ' ', 2))
   if which = '' then which = 'ACCOUNT'
   if field(trim(@sentence), ' ', 3) # '' or (which # 'ACCOUNT' and which # 'ADMIN' and which # 'GLOBAL') then
      display 'SET.PASSWORD [ADMIN | GLOBAL]'
      stop
   end

   is.admin = kernel(K$ADMINISTRATOR, -1)
   is.global = kernel(K$GLOBAL.SESSION, -1)

   acc.name = downcase(@who)
   known = @false
   if acc.name # 'sdsys' then
      openpath @sdsys : @ds : 'accounts' to acc.f then
         read acc.rec from acc.f, acc.name then known = @true
         close acc.f
      end
   end
   if not(known) then
      display sysmsg(12015, @who) ;* %1 cannot have an account password
      stop
   end

*  Whether this computer has a global password (ruling 15: the mode IS that).
   has.global = @false
   openpath @sdsys : @ds : '$cred' to cred.f then
      read g.rec from cred.f, '$GLOBAL' then has.global = @true
      close cred.f
   end

   begin case
      case which = 'ACCOUNT'
         cred.key = upcase(acc.name)
      case which = 'ADMIN'
         if not(is.admin) then
            display sysmsg(2001) ;* Command requires administrator privileges
            stop
         end
         cred.key = '$ADMIN'
      case which = 'GLOBAL'
         if not(has.global) then
            display sysmsg(12034) ;* This computer is standalone - it has no global password
            stop
         end
         if not(is.global) then
            display sysmsg(12033) ;* The global password can only be changed by the SD Core server
            void kernel(K$AUDIT, 'GLOBAL PASSWORD REFUSED - not a global-password session')
            stop
         end
         cred.key = '$GLOBAL'
   end case

*  Ruling 39: the account password without ADMIN asks the CURRENT one first.
   if which = 'ACCOUNT' and not(is.admin) then
      display sysmsg(12031) : ' ' :  ;* Current password:
      input pw0 HIDDEN
      display
      ok0 = @false
      if pw0 # '' then call !CRED_VERIFY(cred.key, pw0, ok0)
      pw0 = ''
      if not(ok0) then
         display sysmsg(12032) ;* Wrong password - the password is unchanged
         void kernel(K$AUDIT, 'ACCOUNT PASSWORD REFUSED account=' : acc.name : ' - wrong current password')
         stop
      end
   end

   display sysmsg(12009) : ' ' :  ;* New password:
   input pw1 HIDDEN
   display
   display sysmsg(12010) : ' ' :  ;* Confirm the new password:
   input pw2 HIDDEN
   display

   if pw1 = '' or pw1 # pw2 then
      pw1 = '' ; pw2 = ''
      display sysmsg(12011) ;* The passwords do not match - the password is unchanged
      stop
   end
   pw2 = ''

   for i = 1 to len(pw1)
      c = seq(pw1[i,1])
      if c < 33 or c > 126 then
         pw1 = ''
         display sysmsg(12013) ;* Use letters, digits and punctuation only...
         stop
      end
   next i

   if not(pw_complex(pw1)) then
      pw1 = ''
      display sysmsg(10920) ;* A password needs at least 8 characters, with...
      stop
   end

*  The three must differ where they exist.  CRED_VERIFY fails closed on a
*  missing record, so a password that does not exist (standalone: no
*  $GLOBAL) never matches.  Ruling 19 for the account against the global
*  (12014, as before); the installer's rule for the other pairs (12035).
   same = @false
   begin case
      case which = 'ACCOUNT'
         call !CRED_VERIFY('$GLOBAL', pw1, same)
         if same then
            pw1 = ''
            display sysmsg(12014) ;* The account password must differ from the global password
            stop
         end
      case which = 'ADMIN'
         call !CRED_VERIFY('$GLOBAL', pw1, same)
      case which = 'GLOBAL'
         call !CRED_VERIFY(upcase(acc.name), pw1, same)
         if not(same) then call !CRED_VERIFY('$ADMIN', pw1, same)
   end case
   if same then
      pw1 = ''
      display sysmsg(12035) ;* The account, administrator and global passwords must all differ
      stop
   end

   stored = @false
   call !CRED_SET(cred.key, pw1, stored)
   if not(stored) then
      pw1 = ''
      display sysmsg(12016, status()) ;* The password could not be stored (status %1)
      stop
   end

*  26 Sep 26 - SOLO 15 piece 4: rewrite the DPAPI copy one-shot commands use
*  (ruling 21, "updates automatically").  The password HAS changed by now, so
*  a failure here is reported but does not undo it: a stale copy no longer
*  verifies, and login then reads the one-shot's input instead.  The account
*  password only - the copy never holds the other two.
   kept = @true
   if which = 'ACCOUNT' then
      kept = @false
      call !SOLO_STORE_PW(upcase(acc.name), pw1, kept)
   end
   pw1 = ''

   begin case
      case which = 'ACCOUNT' ; void kernel(K$AUDIT, 'ACCOUNT PASSWORD SET account=' : acc.name)
      case which = 'ADMIN'   ; void kernel(K$AUDIT, 'ADMIN PASSWORD SET')
      case which = 'GLOBAL'  ; void kernel(K$AUDIT, 'GLOBAL PASSWORD SET')
   end case
   @system.return.code = 0
   display sysmsg(12012) ;* Password changed
   if not(kept) then
      display sysmsg(12022, status()) ;* ...could not be kept for one-shot commands (status %1)
   end
end

* END-CODE
