* START-HISTORY:
* 9 Nov 26 Windows port - from Linux Solo 15767b9 (SOLO 47, the owner: "the windows solo should get pdf").  The program is always a full path (there is no search of three folders), and the path may have spaces, so
*               everything after the purpose is the path; a pair of double quotes round it is taken off.  The message ids are Linux's plus 1005.
* 23 Oct 26 dm  New (S.75; the owner: "an admin screen to setup which programs are allowed to bypass the os.execute restriction globally ... normally GUI programs
*               that do not allow actual access to the OS").
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SET.VIEWER                          says which programs are allowed
*   SET.VIEWER ADD pdf program          allows the program for pdf
*   SET.VIEWER REMOVE pdf program       stops allowing it
*
*   The administrator's verb.  NOTHING IS ALLOWED AS DELIVERED: PDF says no viewer has been allowed until one is added here.  The program is the full path of an .exe, such as
*   "C:/Program Files/Some Reader/reader.exe" (double quotes are optional; / or \ both do).  A program is added only if !VIEWLIST's test passes (an existing regular .exe under Program Files or the
*   Windows folder, owned by SYSTEM, the Administrators or TrustedInstaller, that no ordinary user can write), and the same test is made each time PDF starts it.  Passing the test does not make a
*   program safe: a graphical viewer can open other files its user may read and follow links, which is why this is the administrator's list and not a setting of an account.  Takes effect at once.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set.viewer
$catalog $setviewer

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001) ;* Command requires administrator privileges
   end

   words = trim(@sentence)
   n.words = dcount(words, ' ')

   if n.words = 1 then
      gosub list.all
      @system.return.code = 0
      stop
   end
   if n.words < 4 then stop sysmsg(12895)                        ;* set.viewer {add | remove} pdf program

   action = downcase(field(words, ' ', 2))
   purpose = downcase(field(words, ' ', 3))
   arg = trim(field(words, ' ', 4, 99))
   if arg[1, 1] = '"' and arg[len(arg), 1] = '"' and len(arg) >= 2 then arg = arg[2, len(arg) - 2]
   if action # 'add' and action # 'remove' then stop sysmsg(12895)
   if purpose # 'pdf' then stop sysmsg(12902, purpose[1, 40])    ;* %1 is not a purpose; only pdf can be set

   call !viewlist('native', arg, path, 0)
   if action = 'remove' and path = '' then path = arg            ;* the program may be gone from the disk, or typed in a spelling that is not a path
   call !viewlist('get', purpose, paths, 0)
   locate path in paths<1> setting p then there = 1 else there = 0

   if action = 'add' then
      if path = '' then stop sysmsg(12904, arg[1, 60])           ;* %1 is not a full path
      if there then
         @system.return.code = 0
         stop sysmsg(12898, path, purpose)                       ;* %1 was already allowed for %2; nothing changed
      end
      call !viewlist('check', path, why, 0)
      if why # '' then stop sysmsg(12854, path, why)             ;* The viewer %1 cannot be used: %2
      paths<-1> = path
   end else
      if not(there) then
         @system.return.code = 0
         stop sysmsg(12899, arg[1, 60], purpose)                 ;* %1 was not allowed for %2; nothing changed
      end
      del paths<p>
   end
   call !viewlist('put', purpose, paths, wrote)
   if not(wrote) then
      @system.return.code = -ER$FAILED
      stop sysmsg(12903)                                         ;* The list of allowed programs could not be written
   end
   @system.return.code = 0
   void kernel(K$AUDIT, 'set.viewer ' : action : ' purpose=' : purpose : ' program=' : path)
   display sysmsg((if action = 'add' then 12896 else 12897), path, purpose)
   stop

list.all:
   found = 0
   call !viewlist('get', 'pdf', paths, 0)
   for i = 1 to dcount(paths, @fm)
      display sysmsg(12900, 'pdf', paths<i>)                     ;* Allowed for %1: %2
      found = 1
   next i
   if not(found) then display sysmsg(12901)                      ;* No program is allowed to be started without os.execute
   return

end

* END-CODE
