*              answers ($tk_menubar) and which are therefore in no page's key table (messages 15002, 15003).
* 10 Nov 26 dm  SOLO CARRY (S.117): Core's box (the keys of the pane above the text) with Solo's Documentation button kept: Core's S.187 removed the button
*              with its pdf verb, and Solo keeps the pdf verb (owner, 9 Nov 2026).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $tk_help(op, a, b, c, d)         ALWAYS FIVE ARGUMENTS: a call with fewer stops with "Argument count mismatch" (pad with 0, as $tk_keys is padded)
*
*     'text'  a = the key       b = the title, c = the text (one paragraph to a field), d = the name of a document (null if none)  - returned
*     'box'   a = the key       b = a line for the status bar (null when the person only read it)  - returned.  (30 Oct 26) When an app is drawing its frame, the box
*                               opens with the heading "Keys in this pane" and the keys of the pane with the focus, one line each ("^S  Save", the reason after a key that is not
*                               available now), made from the app's key table; then the page's help text.  Shows the help in a box with a
*                               Close button and, when the record names a document, a Documentation button that runs pdf <name> through $tk_run
*                               (Close is the default).  b is what pdf said, or null.  A session with no terminal gets nothing.
*     'mark'  a = x, b = y      draws the [?] button
*     'hit'   a = the event of SCREEN MOUSE, b = x, c = y     d = 1 when the event is a left press on the button drawn by 'mark' at x, y; else 0
*
*   THE KEY.  page.setting in lower case, a-z 0-9 dot dash underscore, up to 80 characters (tool.menus.starts-in, tool.menus.tile.terminal).  A key
*   with any other character is not looked up at all.
*
*   THE STORE.  The record of that key in the file context.help (SD Core keeps it in the shared account; Solo has none, so it is in the SD system directory, next to pdf).  Field 1 is the title, field 2 the name of a documentation PDF (null for none), fields 3 onward the text,
*   one paragraph to a field.  It is opened by path and only read, from an $internal program; the caller supplies a key, never a path.  A missing file or record
*   is answered in words (12835-12837), not with an error.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_help(op, a, b, c, d)
$catalog $tk_help

$include sl.h
$include tk.h

   common /tkreg/ reg.keys, reg.pane, reg.epoch      ;* the key table and pane of the app that is drawing ($tk_frame keeps them, $tk_close clears them)

   begin case
      case op = 'text'
         key = a
         gosub lookup
         b = hdr
         c = lines
         d = doc
      case op = 'box'
         key = a
         b = ''
         gosub show.box
      case op = 'mark'
         screen text '[?]' at a,b attr 'bold'
      case op = 'hit'
         d = 0
         if a<1> = 'press' and a<2> = 1 and a<4> = c and a<3> >= b and a<3> <= b + 2 then d = 1
   end case
   return

* ------------------------------------------------------------------------------------------------- the store

lookup:
   hdr = ''
   lines = ''
   doc = ''
   k = downcase(trim(key))
   ok = (len(k) >= 1 and len(k) <= 80)
   if ok then
      for ci = 1 to len(k)
         if index('abcdefghijklmnopqrstuvwxyz0123456789._-', k[ci, 1], 1) = 0 then ok = 0
      next ci
   end
   rec = ''
   have.file = 0
   if ok then
      * the file of the SD system directory, found from any account
      openpath @sdsys : @ds : 'context.help' to hf then
         have.file = 1
         read rec from hf, k else rec = ''
         close hf
      end
   end
   if rec = '' then
      hdr = sysmsg(12835)
      lines = (if have.file or not(ok) then sysmsg(12836, k[1, 60]) else sysmsg(12837))
   end else
      hdr = rec<1>
      doc = downcase(trim(rec<2>))
      del rec<1>
      del rec<1>
      lines = rec
   end
   return

* ------------------------------------------------------------------------------------------------- the box

show.box:
   if system(25) then return
   gosub lookup
   call $sl_scr('get', scr)
   wrapw = scr<SL.S.W> - 16
   if wrapw > 100 then wrapw = 100
   if wrapw < 20 then wrapw = 20
   body = ''
   rg = ''
   if reg.epoch + 0 > 0 then call $tk_keys('keylist', reg.keys, reg.pane, rg, '', '', '')      ;* F0a: the keys of the pane that has the focus, made from the key table
   kb = ''
   if rg # '' then
      kb<-1> = sysmsg(12249)
      for p = 1 to dcount(rg, @fm)
         kb<-1> = '  ' : rg<p>[1, wrapw - 2]
      next p
      * S.88 K7/K8: a page with a menu bar has the finder and the context menu too (the bar's own keys, in no page's table)
      bm = ''
      call $tk_keys('menus', reg.keys, '', bm, reg.pane, '', '')
      if bm # '' then
         kb<-1> = '  ' : sysmsg(15002)[1, wrapw - 2]
         kb<-1> = '  ' : sysmsg(15003)[1, wrapw - 2]
      end
      kb<-1> = ''
   end
   for p = 1 to dcount(lines, @fm)
      if p > 1 then body<-1> = ''
      call $tk_wrap(lines<p>, wrapw, pieces)
      body<-1> = pieces
   next p
   * the keys go above the text, unless the two together would not fit the screen (the function-key row shows the keys anyway)
   if kb # '' and dcount(kb, @fm) + dcount(body, @fm) <= scr<SL.S.H> - 14 then body = kb : @fm : body
   * Solo keeps the pdf verb (owner, 9 Nov 2026: "the PDF capability should probably remain on Solo as the user will normally be at the computer"), so the box
   *   offers the document as Solo's always did; Core's S.187 removed the button with its pdf verb, and that half is not carried.
   if doc # '' then
      btn = '&Documentation,&Close'
      dflt = 2
   end else
      btn = '&Close'
      dflt = 1
   end
   screen msgbox body title hdr buttons btn default dflt returning bn else bn = 0
   if doc # '' and bn = 1 then
      call $tk_run('pdf', 'pdf ' : doc, out, st, err)
      b = (if err # '' then err else trim(change(out, @fm, ' '))[1, 130])
   end
   return
end

* END-CODE
