# sd-solo-setup.conf - answers for the SD Core Solo for Windows installer
#
# To use it, copy this file to sd-solo-setup.conf beside
# sd-solo-setup-WS2.0-0.exe (on the USB stick, next to the ssh-server and
# python folders) and fill in the answers.  The installer then uses it on
# every computer that does not already have SD Core Solo for Windows.  Without the file
# the installer asks every question itself.
#
# Each item below is explained in comment lines, then a SAMPLE answer
# (commented out), then the line for your answer.  Leave an answer blank and
# the installer asks for it - except global-password, where blank means NONE
# (no SD Core server manages this computer) and nothing is asked.  A silent
# install (/SILENT or /VERYSILENT) shows no page, so a blank there takes the
# default the item names.  An answer the installer cannot accept (a password
# that breaks the rules below, a word that is not off, local or open) is asked
# for too.
#
# The ACCOUNT password is deliberately not here.  With a global password the
# user sets it at this computer's keyboard the first time they run sd.
# Without one the installer asks for it, so an install with no global
# password cannot run unattended.
#
# Nothing else needs answering.  SD Core Solo for Windows is always added to the user's
# PATH, and Python is always installed (from the python folder beside the
# installer) unless Python 3.13 or later is already there.
#
# This file holds passwords in clear text.  Keep the stick safe.

[install]

# admin-password
#   The administrator password.  It unlocks SD's administrator commands
#   (ADMIN).  At least 8 characters, with a lower-case letter, an upper-case
#   letter, a digit and a symbol - letters, digits and punctuation only.
#admin-password=Adm1n-Sample!

admin-password=

# global-password
#   The global password.  Only a computer that an SD Core server manages has
#   one: the server uses it to manage this computer, and it also unlocks the
#   administrator commands.  LEAVE IT BLANK if no SD Core server manages this
#   computer: the installer then says so (in its log and on its last page) and
#   asks nothing.  The same rules as the administrator password, and it must
#   be different from it.
#global-password=Gl0bal-Sample!

global-password=

# api
#   The API listener, always on port 4249: off (no listener), local (this
#   computer only) or open (reachable from the network).  Blank: the installer
#   asks, and a silent install takes off.  An SD Core server that manages this
#   computer reaches it through the API, so a managed computer needs "open".
#api=open

api=

# ssh
#   Solo's own ssh listener, always on port 4251: off, local (this computer
#   only) or open (reachable from the network).  local and open install
#   Microsoft's OpenSSH package from the ssh-server folder when no OpenSSH
#   server is on the computer; off installs nothing.  Blank: the installer
#   asks, and a silent install takes local (off where no OpenSSH server is on
#   the computer).  An SD Core server that manages this computer also uses
#   ssh, so a managed computer needs "open".
#ssh=open

ssh=

# deny-verbs
#   Commands the user of this computer may not run.  A comma-separated list
#   of verb names; each then needs the administrator or global password
#   first, like SD's own administrator commands.  ADMIN, OFF, QUIT and LO are
#   never denied.  Leave it blank to deny nothing extra.  The SD Core server
#   can change the list later with DENY.VERBS.
#deny-verbs=LISTU,CREATE.FILE

deny-verbs=

# ssh-public-key-file
#   A public key file (on this computer) whose owner may ssh straight into
#   sd-solo, on Solo's own ssh port (4251).  A key is optional: ssh also takes
#   the user's Windows account name and password.  Leave it blank for none.
#   (The SD Core server that manages a computer installs its own key through
#   the API.)
#ssh-public-key-file=C:\Users\alex\.ssh\id_ed25519.pub

ssh-public-key-file=

# reload-data
#   Only where the folder %USERPROFILE%\SDCoreSolo holds data kept by an
#   earlier uninstall (the account sduser, sd.conf, the passwords and the
#   settings, with a .sdcore-kept stamp).  yes = reload it into the new
#   installation; no = start clean, and the kept data is moved aside to
#   SDCoreSolo.kept-<date and time>, never deleted.  Blank: the installer asks,
#   and reloads when nobody can be asked (a silent install, or this file
#   answers both passwords).  Where nothing is
#   kept the line does nothing, so one file can say it for every computer.  A
#   reload keeps the kept passwords, unless this file gives a password: then the
#   passwords here replace them.
#reload-data=yes

reload-data=

# os-access
#   Whether to turn on the shell and OS access for the account (20 Oct 2026).  Both are OFF as
#   delivered.  none = leave both as they are (off on a new account); sh = turn on the SH verb and
#   "!"; os = turn on OS.EXECUTE, files and directories outside the account, Python and the
#   editors that run outside SD; both = both.  Blank = the installer asks, and a silent install
#   takes none.  Either switch lets whoever signs in do what the Windows user can do; the
#   administrator can change them later (ADMIN, then set.os.access).  The installer's command line
#   /OSACCESS=sh, os or both wins over this line, and also works on an upgrade.
#os-access=none

os-access=

# viewer
#   A PDF reader the pdf command may start to show the documentation, even
#   though the account has no OS access (16 Nov 2026): none, or the name this
#   computer's App Paths knows it by - msedge, acrobat, acrord32,
#   foxitpdfreader, sumatrapdf, pdfxedit, firefox or chrome.  The program must
#   pass the same test as SET.VIEWER ADD (an .exe under Program Files that only
#   the system and administrators can change).  Nothing is allowed unless it is
#   named.  Blank: the installer asks when one of those readers is installed,
#   and a silent install takes none.
#   Later: ADMIN, then SET.VIEWER or the Bypass programs page (TOOL.VIEWERS).
#viewer=msedge

viewer=

# start
#   Where new sessions start (12 Nov 2026): menu = the home screen, as
#   delivered; terminal = the command prompt.  The administrator can change it
#   later (ADMIN, then set.start.default).  Blank: the installer asks (the
#   home screen unless its box is ticked), and a silent install takes the
#   home screen.  Used on
#   a new installation only: an upgrade keeps what the installation has.
#start=terminal

start=
