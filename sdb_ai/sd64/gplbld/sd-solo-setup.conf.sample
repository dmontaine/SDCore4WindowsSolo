# sd-solo-setup.conf - answers for the SD Core Solo for Windows installer
#
# To use it, copy this file to sd-solo-setup.conf beside
# sd-solo-setup-WS1.1-3.exe (on the USB stick, next to the ssh-server and
# python folders) and fill in the answers.  The installer then uses it on
# every computer that does not already have SD Core Solo for Windows.  Without the file
# the installer asks every question itself.
#
# The file answers only what it gives.  Whether an SD Core server manages the
# computer depends on the global password alone: give one and the computer is
# managed; leave it blank and it is not.  Nothing else changes with it.
#
# Each item below is explained in comment lines, then a SAMPLE answer
# (commented out), then the line for your answer.  Leave an answer blank and
# the installer asks for it - EXCEPT the global password, where blank means
# none (see below).  An answer the installer cannot accept (a password that
# breaks the rules below, a word that is not off, local or open) is asked
# for too.
#
# The ACCOUNT password is deliberately not here.  With a global password the
# user sets it at this computer's keyboard the first time they run sd.
# Without one the installer asks for it, so an install with no global
# password cannot run unattended.
#
# Nothing else needs answering.  SD Core Solo for Windows is always added to the user's
# PATH, and Python is always installed (from the python folder beside the
# installer) unless Python 3.13 or later is already there.
#
# This file holds passwords in clear text.  Keep the stick safe.

[install]

# admin-password
#   The administrator password.  It unlocks SD's administrator commands
#   (ADMIN).  At least 8 characters, with a lower-case letter, an upper-case
#   letter, a digit and a symbol - letters, digits and punctuation only.
#admin-password=Adm1n-Sample!

admin-password=

# global-password
#   The global password.  The SD Core server uses it to manage this
#   computer, and it also unlocks the administrator commands.  The same rules
#   as the administrator password, and it must be different from it.
#   LEAVE IT BLANK, OR LEAVE THE LINE OUT, and this computer has no global
#   password: no SD Core server manages it, and nothing is asked.  A mistyped
#   name here ends the same way.  The installer says so in its log and on its
#   last page.
#global-password=Gl0bal-Sample!

global-password=

# api
#   The SD Core API, port 4249.  off = not provided; local = provided to
#   this computer only; open = provided to other computers too.  Blank: the
#   installer asks.  An SD Core server that manages this computer needs it
#   open.
#api=open

api=

# ssh
#   Solo's own ssh server, port 4251.  off = none, and Microsoft's OpenSSH
#   package is not installed; local = this computer only; open = other
#   computers too.  local and open install the package from the ssh-server
#   folder when no OpenSSH server is on the computer.  Blank: the installer
#   asks.  An SD Core server that manages this computer needs it open.
#ssh=open

ssh=

# deny-verbs
#   Commands the user of this computer may not run.  A comma-separated list
#   of verb names; each then needs the administrator or global password
#   first, like SD's own administrator commands.  ADMIN, OFF, QUIT and LO are
#   never denied.  Leave it blank to deny nothing extra.  The SD Core server
#   can change the list later with DENY.VERBS - so on a computer with no
#   global password the list stays as given until a reinstall.
#deny-verbs=LISTF,CREATE.FILE

deny-verbs=
